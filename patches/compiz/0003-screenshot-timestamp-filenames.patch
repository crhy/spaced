 {
@@ -291,6 +260,48 @@ shotGetXDGDesktopDir (void)
     return NULL;
 }
 
+static Bool
+shotGetFilename (const char *dir,
+		 char       *name,
+		 size_t     length)
+{
+    time_t    now;
+    struct tm local;
+    char      timestamp[32];
+    int       suffix;
+
+    now = time (NULL);
+    if (now == (time_t) -1 || !localtime_r (&now, &local) ||
+	!strftime (timestamp, sizeof (timestamp), "%Y-%m-%d_%H-%M-%S", &local))
+	return FALSE;
+
+    for (suffix = 1; suffix < 10000; suffix++)
+    {
+	char *path = NULL;
+	int  printed;
+
+	if (suffix == 1)
+	    printed = snprintf (name, length, "screenshot-%s.png", timestamp);
+	else
+	    printed = snprintf (name, length, "screenshot-%s-%d.png",
+				timestamp, suffix);
+	if (printed < 0 || (size_t) printed >= length)
+	    return FALSE;
+
+	printed = asprintf (&path, "%s/%s", dir, name);
+	if (printed < 0)
+	    return FALSE;
+	if (access (path, F_OK) != 0)
+	{
+	    free (path);
+	    return TRUE;
+	}
+	free (path);
+    }
+
+    return FALSE;
+}

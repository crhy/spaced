From: Spaced Linux Developers <dev@spacedlinux.com>
Subject: screenshot: use date and time in output filenames

Numbered filenames restart at screenshot1.png whenever the Desktop is empty.
That makes captures ambiguous after they are moved and makes a later capture
easy to confuse with, or overwrite onto, an earlier one.  Use a sortable local
timestamp and retain a numeric suffix only for multiple captures in one second.

--- a/plugins/screenshot.c
+++ b/plugins/screenshot.c
@@ -28,5 +28,6 @@
 #include <stdlib.h>
 #include <string.h>
-#include <dirent.h>
+#include <time.h>
+#include <unistd.h>
 
 #include <compiz-core.h>
@@ -159,38 +160,6 @@ shotTerminate (CompDisplay     *d,
     return FALSE;
 }
 
-static int
-shotFilter (const struct dirent *d)
-{
-    int number;
-
-    if (sscanf (d->d_name, "screenshot%d.png", &number))
-    {
-	int nDigits = 0;
-
-	for (; number > 0; number /= 10)
-	    nDigits++;
-
-	/* make sure there are no trailing characters in the name */
-	if (strlen (d->d_name) == 14 + nDigits)
-	    return 1;
-    }
-    return 0;
-}
-
-static int
-shotSort (const struct dirent **a,
-	  const struct dirent **b)
-{
-    int		  al = strlen ((*a)->d_name);
-    int		  bl = strlen ((*b)->d_name);
-
-    if (al == bl)

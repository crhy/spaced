 static void
+cb_file_dialog_clicked (GtkButton *button, gpointer data)
+{
+  GtkWidget *dialog;
+  const gchar *custom_name;
+  gchar *filename;
+  gchar *basename;
+  gchar *quoted_filename;
+  gchar *command;
+
+  dialog = gtk_file_chooser_dialog_new (_("Choose a shortcut target"),
+                                        GTK_WINDOW (custom_shortcut_dialog),
+                                        GTK_FILE_CHOOSER_ACTION_OPEN,
+                                        _("_Cancel"), GTK_RESPONSE_CANCEL,
+                                        _("_Open"), GTK_RESPONSE_ACCEPT,
+                                        NULL);
+
+  if (gtk_dialog_run (GTK_DIALOG (dialog)) == GTK_RESPONSE_ACCEPT)
+    {
+      filename = gtk_file_chooser_get_filename (GTK_FILE_CHOOSER (dialog));
+      quoted_filename = g_shell_quote (filename);
+      command = g_strdup_printf ("spaced-open-target %s", quoted_filename);
+      gtk_entry_set_text (GTK_ENTRY (custom_shortcut_command_entry), command);
+
+      custom_name = gtk_entry_get_text (GTK_ENTRY (custom_shortcut_name_entry));
+      if (! custom_name || custom_name[0] == '\0')
+        {
+          basename = g_path_get_basename (filename);
+          gtk_entry_set_text (GTK_ENTRY (custom_shortcut_name_entry), basename);
+          g_free (basename);
+        }
+
+      g_free (command);
+      g_free (quoted_filename);
+      g_free (filename);
+    }
+
+  gtk_widget_destroy (dialog);
+}
+
+static void
 setup_dialog (GtkBuilder *builder, GSettings *marco_settings)
 {
   GtkCellRenderer *renderer;

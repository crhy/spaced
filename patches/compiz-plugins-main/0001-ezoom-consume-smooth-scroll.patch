+/* A passive Button4/5 grab starts only after XI2 smooth-scroll valuators
+ * have already reached clients such as Qt. Grab when the configured modifier
+ * chord becomes active, before the first fractional scroll event arrives.
+ * Leave unrelated shortcuts and another plugin's active grab alone.
+ */
+static void
+zoomUpdateWheelGrab (CompDisplay *d, unsigned int mods)
+{
+    CompScreen *s;
+    unsigned int mask = (ShiftMask | ControlMask | Mod1Mask | Mod2Mask |
+                         Mod3Mask | Mod4Mask | Mod5Mask) & ~d->ignoredModMask;
+    Bool match = FALSE;
+    int i;
+    ZOOM_DISPLAY (d);
+
+    for (i = DOPT_IN; i <= DOPT_OUT; i++)
+    {
+        CompAction *a = &zd->opt[i].value.action;
+        unsigned int required = virtualToRealModMask (d, a->button.modifiers);
+        if ((a->type & CompBindingTypeButton) &&
+            (a->button.button == 4 || a->button.button == 5) &&
+            (required & mask) && (mods & mask) == (required & mask))
+            match = TRUE;
+    }
+    for (s = d->screens; s; s = s->next)
+    {
+        Window root, child;
+        int rx, ry, wx, wy;
+        unsigned int buttons;
+        ZOOM_SCREEN (s);
+
+        if (!match && zs->wheelGrabIndex)
+        {
+            removeScreenGrab (s, zs->wheelGrabIndex, NULL);
+            zs->wheelGrabIndex = 0;
+        }
+        else if (match && !s->maxGrab &&
+                 XQueryPointer (d->display, s->root, &root, &child,
+                                &rx, &ry, &wx, &wy, &buttons))
+        {
+            zs->wheelGrabIndex = pushScreenGrab (s, None, "ezoom-wheel");
+            if (zs->wheelGrabIndex)
+            {
+                /* pushScreenGrab uses owner_events=True. XI2 clients still
+                 * receive their scroll valuators with that setting. Update
+                 * our own grab so the server delivers events only to us.
+                 */
+                if (XGrabPointer (d->display, s->grabWindow, FALSE,
+                                  ButtonPressMask | ButtonReleaseMask |
+                                  PointerMotionMask, GrabModeAsync,
+                                  GrabModeAsync, s->root, None,
+                                  CurrentTime) != GrabSuccess)
+                {
+                    removeScreenGrab (s, zs->wheelGrabIndex, NULL);
+                    zs->wheelGrabIndex = 0;
+                }
+            }
+        }
+    }
+}

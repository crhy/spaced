 /**
+ * brisk_apps_backend_launch_spaced_action:
+ *
+ * Hand a desktop file to the distribution's application-action helper.
+ */
+static void brisk_apps_backend_launch_spaced_action(GSimpleAction *action,
+                                                    __brisk_unused__ GVariant *parameter,
+                                                    BriskBackend *backend)
+{
+        const gchar *verb = g_object_get_data(G_OBJECT(action), "__spaced-verb");
+        const gchar *desktop_file = g_object_get_data(G_OBJECT(action), "__desktop-file");
+        gchar *argv[] = {
+                "/usr/local/bin/spaced-app-action",
+                (gchar *)verb,
+                (gchar *)desktop_file,
+                NULL,
+        };
+        GError *error = NULL;
+
+        g_assert(verb != NULL);
+        g_assert(desktop_file != NULL);
+        brisk_backend_hide_menu(backend);
+        if (!g_spawn_async(NULL, argv, NULL, G_SPAWN_DEFAULT, NULL, NULL, NULL, &error)) {
+                g_warning("Unable to start Spaced application action: %s", error->message);
+                g_error_free(error);
+        }
+}

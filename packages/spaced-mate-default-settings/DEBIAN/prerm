#!/bin/sh
set -e

# Remove only the session-guard symlink this package created. An administrator's
# own /usr/sbin/policy-rc.d, or one left by another package, is never deleted.
if [ "${1:-}" = remove ]; then
    # Never leave an unconfirmed GPU layout without its recovery service.
    if [ -f /var/lib/spaced-gpu-manager/trial.json ]; then
        /usr/bin/python3 -c 'import json,sys; s=json.load(open("/var/lib/spaced-gpu-manager/trial.json")); sys.exit(s.get("phase") in ("staged", "trial"))' || {
            echo 'Revert or confirm the pending GPU desktop trial before removing this package.' >&2
            exit 1
        }
    fi
    policy_rc_d=/usr/sbin/policy-rc.d
    if [ "$(readlink "$policy_rc_d" 2>/dev/null)" = /usr/lib/spaced-linux/spaced-policy-rc.d ]; then
        rm -f "$policy_rc_d" || true
    fi
fi

exit 0

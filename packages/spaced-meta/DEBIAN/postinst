#!/bin/sh
set -e

case "${1:-}" in configure|triggered) ;; *) exit 0 ;; esac

PACKAGE_VERSION="$(dpkg-query -W -f='${Version}' spaced-meta 2>/dev/null || true)"
if [ -z "$PACKAGE_VERSION" ]; then
    echo "Cannot determine the installed Spaced release version" >&2
    exit 1
fi
# Debian package revisions deliver fixes without changing the OS release name.
VERSION=${PACKAGE_VERSION#*:}
VERSION=${VERSION%-*}
CODENAME="$(printf '%s' "$VERSION" | tr -d '.')"

identity=$(mktemp)
trap 'rm -f "$identity"' EXIT HUP INT TERM
cat > "$identity" <<EOF
PRETTY_NAME="Spaced Linux $VERSION"
NAME="Spaced Linux"
VERSION_ID="$VERSION"
VERSION="$VERSION"
VERSION_CODENAME="$CODENAME"
BUILD_ID="$PACKAGE_VERSION"
ID=spaced
ID_LIKE=debian
HOME_URL="https://github.com/crhy/spaced"
SUPPORT_URL="https://github.com/crhy/spaced/issues"
BUG_REPORT_URL="https://github.com/crhy/spaced/issues"
EOF

# base-files owns the upstream identity. Refresh every entrypoint together
# when configuring this release (including machines skipping older releases).
install -Dm0644 "$identity" /usr/lib/os-release
install -Dm0644 "$identity" /etc/os-release
cat > /etc/lsb-release <<EOF
DISTRIB_ID=SpacedLinux
DISTRIB_RELEASE=$VERSION
DISTRIB_CODENAME=$CODENAME
DISTRIB_DESCRIPTION="Spaced Linux $VERSION"
EOF
printf 'Spaced Linux %s \\n \\l\n' "$VERSION" > /etc/issue
printf 'Spaced Linux %s\n' "$VERSION" > /etc/issue.net

# Samba disables user shares unless "usershare max shares" is non-zero, and
# Debian's smb.conf leaves that line commented out, so Caja's Sharing Options
# failed with "usershares are currently disabled" (issue #253). Keep any value
# an administrator has set.
smb_conf=/etc/samba/smb.conf
if [ "$1" = configure ] && [ -f "$smb_conf" ] \
    && ! grep -Eq '^[[:space:]]*usershare max shares[[:space:]]*=' "$smb_conf"; then
    sed -i '/^\[global\]/a\   usershare max shares = 100' "$smb_conf"
fi

# Caja's Sharing Options need sambashare membership (issue #253). Calamares
# grants it to new users; give it once to existing desktop users, meaning
# sudo members with ordinary UIDs, without undoing a later removal.
marker=/var/lib/spaced-linux/sambashare-v1
if [ "$1" = configure ] && [ ! -e "$marker" ] && getent group sambashare >/dev/null; then
    for member in $(getent group sudo | cut -d: -f4 | tr ',' ' '); do
        uid=$(id -u "$member" 2>/dev/null) || continue
        [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
        usermod -a -G sambashare "$member" || true
    done
    install -d -m 0755 /var/lib/spaced-linux
    : > "$marker"
fi

# An upgrade which only changes usershare configuration does not run Samba's
# postinst. Start the service once so Caja can resolve Everyone to its SID.
# Starting it was not enough: systems whose smbd boot links were missing or
# disabled lost the share again at the next boot, and other computers got
# "connection refused" (issue #297). Enable it at boot once as well.
# Respect policy-rc.d (including image builds) and keep failed starts retryable.
marker=/var/lib/spaced-linux/smbd-boot-10.26.3
if [ "$1" = configure ] && [ ! -e "$marker" ] && [ -x /etc/init.d/smbd ]; then
    update-rc.d smbd defaults >/dev/null 2>&1 || true
    update-rc.d smbd enable >/dev/null 2>&1 || true
    if /etc/init.d/smbd status >/dev/null 2>&1 \
        || invoke-rc.d --disclose-deny smbd start; then
        install -d -m 0755 /var/lib/spaced-linux
        : > "$marker"
    fi
fi

# Guest ("Everyone") shares inside a 0700 home were listed but every open
# was denied, because guests run as nobody (issue #297). Open existing
# desktop homes to traversal once; never undo a later change.
marker=/var/lib/spaced-linux/home-traverse-10.26.3
if [ "$1" = configure ] && [ ! -e "$marker" ] && [ -x /usr/lib/spaced-linux/spaced-home-traverse ]; then
    /usr/lib/spaced-linux/spaced-home-traverse || true
    install -d -m 0755 /var/lib/spaced-linux
    : > "$marker"
fi

exit 0

{
    "schemaVersion": 1,
    "project": {
        "name": "Spaced Linux",
        "repository": "crhy/spaced",
        "versionFile": "VERSION",
        "target": {
            "distribution": "Devuan Ceres",
            "architecture": "amd64",
            "init": "sysvinit"
        }
    },
    "host": {
        "supportedFamilies": [
            "Devuan",
            "Debian"
        ],
        "packageManager": "apt",
        "dependencies": {
            "core": [
                "bash",
                "ca-certificates",
                "dpkg",
                "git",
                "make",
                "python3",
                "python3-yaml"
            ],
            "build": [
                "curl",
                "debootstrap",
                "gnupg",
                "grub-common",
                "live-build",
                "rsync",
                "squashfs-tools",
                "xorriso"
            ],
            "virtualization": [
                "ovmf",
                "qemu-system-x86",
                "qemu-utils"
            ],
            "optionalValidation": [
                "desktop-file-utils"
            ]
        }
    },
    "projectDependencies": {
        "isoPackages": {
            "format": "yaml",
            "manifest": "config/packages.yaml",
            "generator": "scripts/iso/package-list.sh",
            "generatedPath": "build/live-build/config/package-lists/spaced.list.chroot"
        },
        "localDebianPackages": {
            "builder": "scripts/iso/build-local-packages.sh",
            "sources": [
                "packages/spaced-mate-default-settings",
                "packages/spaced-meta"
            ],
            "stagedDependencies": [
                "spaced-welcome"
            ],
            "outputDirectory": "build/local-packages"
        },
        "externalArtifacts": [
            {
                "name": "spaced-welcome",
                "architecture": "all",
                "repository": "crhy/spacedwelcome",
                "configuration": "config/external-artifacts.conf",
                "versionVariable": "SPACED_WELCOME_VERSION",
                "checksumVariable": "SPACED_WELCOME_SHA256",
                "localOverride": "SPACED_WELCOME_DEB",
                "stagingScript": "scripts/iso/stage-external-artifacts.sh",
                "reason": "Standalone first-login application packaged independently from desktop defaults"
            },
            {
                "name": "SpacedBazaar",
                "architecture": [
                    "x86_64",
                    "aarch64"
                ],
                "repository": "crhy/spacedbazaar",
                "configuration": "config/external-artifacts.conf",
                "versionVariable": "SPACED_BAZAAR_VERSION",
                "checksumVariables": [
                    "SPACED_BAZAAR_SHA256_AMD64",
                    "SPACED_BAZAAR_SHA256_ARM64"
                ],
                "localOverride": "SPACED_BAZAAR_BUNDLE",
                "stagingScript": "scripts/iso/stage-external-artifacts.sh",
                "reason": "System-wide application catalog installed before the first desktop session"
            },
            {
                "name": "spaced-github",
                "architecture": "all",
                "url": "https://crhy.github.io/spacedbazaar/spaced-github.flatpakrepo",
                "repositoryUrl": "https://crhy.github.io/spacedbazaar/flatpak-repo/",
                "configuration": "config/external-artifacts.conf",
                "checksumVariable": "SPACED_GITHUB_REMOTE_SHA256",
                "gpgFingerprintVariable": "SPACED_GITHUB_GPG_FINGERPRINT",
                "localOverride": "SPACED_GITHUB_REMOTE_FILE",
                "stagingScript": "scripts/iso/stage-external-artifacts.sh",
                "reason": "Signed first-party Flatpak catalog for CRHY applications"
            },
            {
                "name": "xkb-data",
                "version": "2.47-1",
                "architecture": "all",
                "sha256": "18f9d6c6999767fdde091b03fdddc635d2b4f7ec3dbb210621c9f2062b7ef1cb",
                "stagingScript": "scripts/iso/stage-transition-packages.sh",
                "reason": "Temporary Devuan Ceres compatibility pin for keyboard-configuration 1.248"
            }
        ]
    },
    "commands": {
        "installDependencies": "make deps",
        "validate": "make check",
        "buildIso": "make iso-build",
        "buildRelease": "make release",
        "testIso": "make iso-test"
    },
    "constraints": {
        "forbiddenInitPackages": [
            "systemd",
            "systemd-sysv"
        ],
        "notes": [
            "APT packages for the live ISO remain authoritative in config/packages.yaml.",
            "This file describes dependency locations and host tooling; it does not duplicate the complete ISO package list."
        ]
    }
}

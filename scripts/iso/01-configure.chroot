#!/bin/bash
# Spaced Linux live system configuration
set -e

# Keep the distribution identity consistent across tools that read either path.
install -Dm0644 /etc/os-release /usr/lib/os-release

# Enable user autologin
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-spaced.conf <<'LIGHTDM'
[LightDM]
# Reuse Plymouth's active VT. Headless KVM can otherwise leave Xorg waiting
# forever for a switch from tty1 to LightDM's traditional tty7.
minimum-vt=1

[Seat:*]
autologin-user=user
autologin-user-timeout=0
greeter-session=lightdm-gtk-greeter
session-setup-script=/usr/local/sbin/spaced-lightdm-session-setup
user-session=mate
LIGHTDM

# Install MATE session support after the local Spaced defaults package.
dpkg -s spaced-mate-default-settings >/dev/null 2>&1 || {
    echo "spaced-mate-default-settings was not installed" >&2
    exit 1
}
DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=6 -o Acquire::http::Timeout=30 install -y --no-install-recommends mate-session-manager

# Compile the defaults supplied by the Spaced Linux overlay.
glib-compile-schemas /usr/share/glib-2.0/schemas/

# Make both signed catalogs visible in the live system before SpacedBazaar or
# Welcome can start. The descriptors were verified on the build host; no
# unsigned or dynamically selected repository is accepted here.
for remote in flathub spaced-github; do
    descriptor="/usr/share/flatpak/remotes.d/$remote.flatpakrepo"
    [ -s "$descriptor" ] || {
        echo "Missing signed Flatpak descriptor: $descriptor" >&2
        exit 1
    }
    /usr/bin/flatpak remote-add --system --if-not-exists "$remote" "$descriptor"
done

# SpacedBazaar is part of the base desktop rather than a post-login suggestion.
# Install the checksum-verified bundle into the system Flatpak installation so
# it is already exported in both the live session and the Calamares target.
bazaar_bundle=/usr/share/spaced-linux/bootstrap/SpacedBazaar.flatpak
[ -s "$bazaar_bundle" ] || {
    echo "Missing staged SpacedBazaar bundle" >&2
    exit 1
}
bazaar_installed=
for attempt in 1 2 3; do
    echo "Installing SpacedBazaar (attempt $attempt of 3)"
    if /usr/bin/flatpak install --system --noninteractive -y "$bazaar_bundle" &&
       /usr/bin/flatpak info --system io.github.crhy.SpacedBazaar >/dev/null; then
        bazaar_installed=1
        break
    fi
    sleep 5
done
[ -n "$bazaar_installed" ] || {
    echo "SpacedBazaar could not be installed into the system Flatpak installation" >&2
    exit 1
}
bazaar_origin=$(/usr/bin/flatpak info --show-origin --system io.github.crhy.SpacedBazaar)
[ "$bazaar_origin" = spaced-github ] || {
    echo "SpacedBazaar bundle is not updateable from spaced-github (origin: ${bazaar_origin:-none})" >&2
    exit 1
}
bazaar_arch=$(/usr/bin/flatpak --default-arch)
bazaar_ref=$(/usr/bin/flatpak info --show-ref --system io.github.crhy.SpacedBazaar)
case $bazaar_ref in
    app/io.github.crhy.SpacedBazaar/"$bazaar_arch"/*) ;;
    *)
        echo "SpacedBazaar bundle ref '$bazaar_ref' does not match host architecture '$bazaar_arch'" >&2
        exit 1
        ;;
esac
rm -f -- "$bazaar_bundle"

# Compiz's GTK window decorator, which it links from the MATE window
# decoration library, trusts _NET_WM_PID as a host PID when decorating a
# window. X11 apps inside Flatpak publish a PID from their private namespace,
# so the decorator can look up an unrelated root-owned host process and append
# the alarming but false "(as superuser)" suffix. There is no setting for this
# behavior. Neutralize only that root-title format string in the decoration
# library, keeping the library size and every other cross-user title
# annotation intact.
python3 - <<'PY'
from pathlib import Path

old = b"%s (as superuser)"
new = b"%s\0" + b" " * (len(old) - 3)
libraries = sorted(Path("/usr/lib").glob("*/libmarco-private.so.*.*.*"))
if not libraries:
    raise SystemExit("libmarco-private was not found")
for library in libraries:
    data = library.read_bytes()
    occurrences = data.count(old)
    if occurrences != 1:
        raise SystemExit(f"{library}: expected one superuser title string, found {occurrences}")
    library.write_bytes(data.replace(old, new))
PY

# mate-control-center opens its shell at a hardcoded stock default of
# 975x600, but its icon grid only fills roughly 743x633, leaving an odd
# empty band at the bottom and right of the window. There is no window-rule
# mechanism and no gsettings key for this, so resize the compiled-in
# default by patching the two 32-bit immediates (mov $width,%r8d ; mov
# $height,%r9d) inside create_main_window.
python3 - <<'PY'
from pathlib import Path

default_width, default_height = 743, 633
path = Path("/usr/bin/mate-control-center")
data = path.read_bytes()

def patch_immediate(data_bytes, opcode, old_imm, new_imm):
    # match: opcode + 4-byte little-endian immediate
    old = opcode + old_imm.to_bytes(4, "little")
    new = opcode + new_imm.to_bytes(4, "little")
    occurrences = data_bytes.count(old)
    if occurrences != 1:
        raise SystemExit(
            f"mate-control-center: expected one {old_imm:#x} immediate, "
            f"found {occurrences}")
    return data_bytes.replace(old, new)

# width:  mov $0x3cf(975),%r8d  -> 743
data = patch_immediate(data, b"\x41\xb8", 0x3cf, default_width)
# height: mov $0x258(600),%r9d  -> 633
data = patch_immediate(data, b"\x41\xb9", 0x258, default_height)
path.write_bytes(data)
PY

# Create the live user if live-config has not already done so.
id -u user >/dev/null 2>&1 || useradd -m -s /bin/bash user
echo "user:1" | chpasswd
echo "root:spaced" | chpasswd
usermod -aG sudo,audio,video,plugdev,netdev user
printf 'user ALL=(ALL:ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/spaced-live
chmod 0440 /etc/sudoers.d/spaced-live

# Cairo-Dock requires current_theme to be a directory containing a real theme.
# Seed its smallest bundled layout at image-build time without carrying a
# second copy of that upstream data in this repository.
rm -rf /etc/skel/.config/cairo-dock
if [ -d /usr/share/cairo-dock/themes/Default-Single ]; then
    mkdir -p /etc/skel/.config/cairo-dock/current_theme
    cp -a /usr/share/cairo-dock/themes/Default-Single/. \
        /etc/skel/.config/cairo-dock/current_theme/
    rm -rf /etc/skel/.config/cairo-dock/current_theme/launchers
    mkdir -p /etc/skel/.config/cairo-dock/current_theme/launchers
    cp -a /usr/share/spaced-themes/cairo-dock/launchers/. \
        /etc/skel/.config/cairo-dock/current_theme/launchers/
    sed -i -e 's/^modules=.*/modules=/' \
        -e 's/^visibility=.*/visibility=0/' \
        /etc/skel/.config/cairo-dock/current_theme/cairo-dock.conf
    touch /etc/skel/.config/cairo-dock/current_theme/.spaced-launchers-v1
fi

cp -a /etc/skel/. /home/user/
chown -R user:user /home/user

# Keep only the supported Spaced themes; remove every other theme directory
# (stock sample themes and any stale leftovers) so they don't clutter
# the Appearance chooser.
find /usr/share/themes -mindepth 1 -maxdepth 1 \
    ! -name Spaced-Dark -a ! -name Spaced-Linux-Dark -a ! -name Spaced-Linux-Light \
    -a ! -name Spaced-MacOS -a ! -name Spaced-Win311 -a ! -name Spaced-WinXP \
    -a ! -name Spaced-Mint -a ! -name Spaced-Win11-Light -a ! -name Spaced-Win11-Dark \
    -a ! -name Spaced-Geoworks -a ! -name Spaced-Android \
    -exec rm -rf -- {} + || true

# Keep Debian's Calamares module defaults, but never expose its launcher or
# branding beside the Spaced Linux installer.
rm -f /usr/share/applications/calamares-install-debian.desktop \
    /usr/share/applications/calamares.desktop.orig \
    /usr/share/pixmaps/install-debian.png \
    /etc/xdg/autostart/calamares-desktop-icon.desktop \
    /usr/bin/add-calamares-desktop-icon \
    /usr/bin/calamares-install-debian
rm -rf /etc/calamares/branding/debian

for icon_theme in /usr/share/icons/Spaced-Icons-*; do
    [ -d "$icon_theme" ] || continue
    gtk-update-icon-cache -f "$icon_theme" >/dev/null 2>&1 || true
done

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R spaced
fi

# Universal NVIDIA-safe live image.
rm -f /etc/X11/xorg.conf /etc/X11/xorg.conf.d/*nvidia*.conf 2>/dev/null || true
rm -f /etc/modprobe.d/nvidia-installer-disable-nouveau.conf 2>/dev/null || true
# Synchronize build/live clock when networking is available.
/usr/local/sbin/spaced-sync-time || true
# Enable chrony on installed/live systems.
[ ! -e /etc/init.d/chrony ] || update-rc.d chrony defaults
[ ! -e /etc/init.d/spaced-first-boot-snapshot ] || \
  update-rc.d spaced-first-boot-snapshot defaults 98
# Let GRUB discover other installed operating systems.
if [ -f /etc/default/grub ]; then
  sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
  grep -q '^GRUB_DISABLE_OS_PROBER=' /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub
fi

apt-get clean

# Enable SSH for remote debugging/administration.
if [ -f /etc/init.d/ssh ]; then
    update-rc.d ssh enable 2>/dev/null || true
    mkdir -p /etc/ssh/sshd_config.d
    printf 'PasswordAuthentication yes\nPermitRootLogin yes\n' > /etc/ssh/sshd_config.d/10-spaced.conf
fi

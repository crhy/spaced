#!/bin/bash
# Run the ordered, independently testable live-image configuration helpers.
set -euo pipefail

helper_dir=/usr/lib/spaced-linux/live-build-configure.d
shopt -s nullglob
helpers=("$helper_dir"/*.sh)
[ "${#helpers[@]}" -gt 0 ] || {
    echo "No live-build configuration helpers found in $helper_dir" >&2
    exit 1
}

for helper in "${helpers[@]}"; do
    echo "Running ${helper##*/}"
    "$helper"
done

# These helpers are build inputs, not installed-system runtime components.
rm -rf "$helper_dir"

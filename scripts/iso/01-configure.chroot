#!/bin/bash
# Spaced Linux live system configuration
set -e

# Keep the distribution identity consistent across tools that read either path.
install -Dm0644 /etc/os-release /usr/lib/os-release

# Enable user autologin
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-spaced.conf <<'LIGHTDM'
[LightDM]
# Reuse Plymouth's active VT. Headless KVM can otherwise leave Xorg waiting
# forever for a switch from tty1 to LightDM's traditional tty7.
minimum-vt=1

[Seat:*]
autologin-user=user
autologin-user-timeout=0
greeter-session=lightdm-gtk-greeter
session-setup-script=/usr/local/sbin/spaced-lightdm-session-setup
user-session=mate
LIGHTDM

# Install MATE session support after the local Spaced defaults package.
dpkg -s spaced-mate-default-settings >/dev/null 2>&1 || {
    echo "spaced-mate-default-settings was not installed" >&2
    exit 1
}
DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=6 -o Acquire::http::Timeout=30 install -y --no-install-recommends mate-session-manager

# Compile the defaults supplied by the Spaced Linux overlay.
glib-compile-schemas /usr/share/glib-2.0/schemas/

# Make both signed catalogs visible in the live system before SpacedBazaar or
# Welcome can start. The descriptors were verified on the build host; no
# unsigned or dynamically selected repository is accepted here.
for remote in flathub spaced-github; do
    descriptor="/usr/share/flatpak/remotes.d/$remote.flatpakrepo"
    [ -s "$descriptor" ] || {
        echo "Missing signed Flatpak descriptor: $descriptor" >&2
        exit 1
    }
    /usr/bin/flatpak remote-add --system --if-not-exists "$remote" "$descriptor"
done

# Do not install applications or runtimes in the live filesystem. The small
# native Welcome package installs SpacedBazaar and the optional app catalog for
# the user only after Calamares has completed.

# Upstream binaries remain package managed. Source-level fixes are built as
# versioned Debian packages, so installed systems receive the same changes.

# Create the live user if live-config has not already done so.
id -u user >/dev/null 2>&1 || useradd -m -s /bin/bash user
echo "user:1" | chpasswd
echo "root:spaced" | chpasswd
usermod -aG sudo,audio,video,plugdev,netdev user
printf 'user ALL=(ALL:ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/spaced-live
chmod 0440 /etc/sudoers.d/spaced-live

# Cairo-Dock requires current_theme to be a directory containing a real theme.
# Seed its smallest bundled layout at image-build time without carrying a
# second copy of that upstream data in this repository.
rm -rf /etc/skel/.config/cairo-dock
if [ -d /usr/share/cairo-dock/themes/Default-Single ]; then
    mkdir -p /etc/skel/.config/cairo-dock/current_theme
    cp -a /usr/share/cairo-dock/themes/Default-Single/. \
        /etc/skel/.config/cairo-dock/current_theme/
    rm -rf /etc/skel/.config/cairo-dock/current_theme/launchers
    mkdir -p /etc/skel/.config/cairo-dock/current_theme/launchers
    cp -a /usr/share/spaced-themes/cairo-dock/launchers/. \
        /etc/skel/.config/cairo-dock/current_theme/launchers/
    sed -i -e 's/^modules=.*/modules=/' \
        -e 's/^visibility=.*/visibility=0/' \
        /etc/skel/.config/cairo-dock/current_theme/cairo-dock.conf
    touch /etc/skel/.config/cairo-dock/current_theme/.spaced-launchers-v1
fi

cp -a /etc/skel/. /home/user/
chown -R user:user /home/user

# Keep Debian's Calamares module defaults, but never expose its launcher or
# branding beside the Spaced Linux installer.
rm -f /usr/share/applications/calamares-install-debian.desktop \
    /usr/share/applications/calamares.desktop.orig \
    /usr/share/pixmaps/install-debian.png \
    /etc/xdg/autostart/calamares-desktop-icon.desktop \
    /usr/bin/add-calamares-desktop-icon \
    /usr/bin/calamares-install-debian
rm -rf /etc/calamares/branding/debian

for icon_theme in /usr/share/icons/Spaced-Icons-*; do
    [ -d "$icon_theme" ] || continue
    gtk-update-icon-cache -f "$icon_theme" >/dev/null 2>&1 || true
done

# Universal NVIDIA-safe live image.
rm -f /etc/X11/xorg.conf /etc/X11/xorg.conf.d/*nvidia*.conf 2>/dev/null || true
rm -f /etc/modprobe.d/nvidia-installer-disable-nouveau.conf 2>/dev/null || true
# Synchronize build/live clock when networking is available.
/usr/local/sbin/spaced-sync-time || true
# Enable chrony on installed/live systems.
[ ! -e /etc/init.d/chrony ] || update-rc.d chrony defaults
[ ! -e /etc/init.d/spaced-first-boot-snapshot ] || \
  update-rc.d spaced-first-boot-snapshot defaults 98
# Let GRUB discover other installed operating systems.
if [ -f /etc/default/grub ]; then
  sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
  grep -q '^GRUB_DISABLE_OS_PROBER=' /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub
fi

apt-get clean

# Enable SSH for remote debugging/administration.
if [ -f /etc/init.d/ssh ]; then
    update-rc.d ssh enable 2>/dev/null || true
    mkdir -p /etc/ssh/sshd_config.d
    printf 'PasswordAuthentication yes\nPermitRootLogin yes\n' > /etc/ssh/sshd_config.d/10-spaced.conf
fi

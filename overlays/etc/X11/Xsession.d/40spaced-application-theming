# /etc/X11/Xsession never reads /etc/profile.d, so the toolkit theming exports
# would be absent from the running desktop and Qt apps (VLC) and LibreOffice
# would ignore the Spaced theme (issue #339).
if [ -r /etc/profile.d/spaced-application-theming.sh ]; then
    . /etc/profile.d/spaced-application-theming.sh
fi

# Flatpak cannot add a previously absent filesystem grant to a running app.
# Create the narrow palette directory before any desktop autostarts launch;
# the theme monitor fills it in once the session settings are available.
if [ -n "${HOME:-}" ]; then
    (umask 077; mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/spaced") 2>/dev/null || true
fi

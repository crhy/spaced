#!/bin/sh
# NetworkManager brings Wi-Fi up asynchronously.  sysvinit's $network facility
# only means that NetworkManager itself has started, so smbd and wsdd can run
# too early, find no usable interface, and exit.  Bring both up once an
# interface really is usable, in the right order, and never on a down event.

case "${2:-}" in
    up|dhcp4-change|dhcp6-change) ;;
    *) exit 0 ;;
esac

init_script=${SPACED_SMBD_INIT:-/etc/init.d/smbd}
wsdd_script=${SPACED_WSDD_INIT:-/etc/init.d/spaced-wsdd}
rc_root=${SPACED_RC_ROOT:-/etc}
lock_file=${SPACED_SAMBA_LOCK:-/run/lock/spaced-samba-ready.lock}

[ -x "$init_script" ] || exit 0

# Do not undo an administrator's decision to disable Samba at boot.
enabled=false
for link in "$rc_root"/rc[2-5].d/S[0-9][0-9]smbd; do
    if [ -L "$link" ]; then
        enabled=true
        break
    fi
done
[ "$enabled" = true ] || exit 0

# Multiple interfaces can become ready together.  Serialize their callbacks,
# then recheck status so a healthy daemon is never restarted or raced against.
exec 9>"$lock_file" || exit 0
flock -n 9 || exit 0

# smbd first: a share must answer before it is announced.  Close the lock
# descriptor (9>&-) for the start so a backgrounded daemon does not keep the
# lock for its lifetime (AGENTS.md), and check status so a repeated up is a
# no-op instead of a second, racing start.
if ! "$init_script" status >/dev/null 2>&1; then
    if ! "$init_script" start 9>&-; then
        logger -t spaced-samba-ready \
            "smbd did not start after NetworkManager reported ${1:-an interface} ${2:-up}"
    fi
fi

# Then WS-Discovery, ordered after smbd (spaced-wsdd Should-Start: smbd) so it
# announces shares that already work.  A boot-time update-rc.d start runs before
# the asynchronous interface is ready and leaves Windows unable to list this
# computer, so retry it here too - status first, lock descriptor closed, once.
if [ -x "$wsdd_script" ]; then
    if ! "$wsdd_script" status >/dev/null 2>&1; then
        if ! "$wsdd_script" start 9>&-; then
            logger -t spaced-samba-ready \
                "spaced-wsdd did not start after NetworkManager reported ${1:-an interface} ${2:-up}"
        fi
    fi
fi

# A service failure must not make NetworkManager mark the connection failed.
exit 0

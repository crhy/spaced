#!/bin/sh
# NetworkManager brings Wi-Fi up asynchronously.  sysvinit's $network facility
# only means that NetworkManager itself has started, so smbd can run too early,
# find no interfaces, and exit.  Retry it once an interface really is usable.

case "${2:-}" in
    up|dhcp4-change|dhcp6-change) ;;
    *) exit 0 ;;
esac

smbd_init=${SPACED_SMBD_INIT:-/etc/init.d/smbd}
wsdd_init=${SPACED_WSDD_INIT:-/etc/init.d/spaced-wsdd}
rc_root=${SPACED_RC_ROOT:-/etc}
lock_file=${SPACED_SAMBA_LOCK:-/run/lock/spaced-samba-ready.lock}

service_enabled() {
    service=$1
    for link in "$rc_root"/rc[2-5].d/S[0-9][0-9]"$service"; do
        [ -L "$link" ] && return 0
    done
    return 1
}

[ -x "$smbd_init" ] || exit 0
# Do not undo an administrator's decision to disable Samba at boot.
service_enabled smbd || exit 0

# Multiple interfaces can become ready together.  Serialize their callbacks,
# then recheck status so a healthy daemon is never restarted.
exec 9>"$lock_file" || exit 0
flock -n 9 || exit 0
if ! "$smbd_init" status >/dev/null 2>&1; then
    # A daemon started by an init script must not inherit this dispatcher's
    # lock descriptor or it will keep every later network event locked out.
    if ! "$smbd_init" start 9>&-; then
        logger -t spaced-samba-ready \
            "smbd did not start after NetworkManager reported ${1:-an interface} ${2:-up}"
        exit 0
    fi
fi

# Never advertise a server which did not survive startup.  Conversely, recover
# WSDD even when smbd was already healthy; the old early return made a failed
# discovery daemon stay failed until the next reboot.
if ! "$smbd_init" status >/dev/null 2>&1; then
    logger -t spaced-samba-ready \
        "smbd is not running after NetworkManager reported ${1:-an interface} ${2:-up}"
    exit 0
fi
if [ -x "$wsdd_init" ] && service_enabled spaced-wsdd \
        && ! "$wsdd_init" status >/dev/null 2>&1; then
    if ! "$wsdd_init" start 9>&-; then
        logger -t spaced-samba-ready \
            "spaced-wsdd did not start after NetworkManager reported ${1:-an interface} ${2:-up}"
    fi
fi

# A service failure must not make NetworkManager mark the connection failed.
exit 0

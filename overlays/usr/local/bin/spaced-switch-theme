#!/bin/bash
# Apply only the desktop details MATE metathemes cannot encode.
set -u

THEMES_JSON=/usr/share/spaced-themes/themes.json
THEME_ID=${1:-}

if [ -z "$THEME_ID" ]; then
    echo "Usage: $0 <theme-id>" >&2
    exit 2
fi

# Issue #181: switching several themes in a row in Appearance Preferences
# pegged the CPU and took the desktop down with it. Every switch used to run
# its panel, dock and Flatpak export work concurrently with the previous one.
# One exclusive lock per user means the work happens once per settled choice.
LOCK_DIR=${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}
mkdir -p "$LOCK_DIR" 2>/dev/null || true
exec 7>"$LOCK_DIR/spaced-switch-theme.lock" 2>/dev/null || true
flock 7 2>/dev/null || true

assignments=$(python3 - "$THEMES_JSON" "$THEME_ID" <<'PY'
import json
import shlex
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    themes = json.load(source)["themes"]

for theme in themes:
    if theme["id"] == sys.argv[2]:
        for key in ("name", "gtk_theme", "wallpaper", "panel_layout", "panel_position", "panel_size", "panel_color", "cairo_dock", "dark"):
            print(f"{key}={shlex.quote(str(theme.get(key, '')))}")
        break
else:
    sys.exit(1)
PY
) || {
    echo "Unknown Spaced Linux theme: $THEME_ID" >&2
    exit 1
}
eval "$assignments"

# MATE owns painting. Setting the standard key once is enough and still lets a
# user choose another background afterwards without a watcher fighting them.
if [ -f "$wallpaper" ]; then
    gsettings set org.mate.background picture-filename "$wallpaper" 2>/dev/null || true
    gsettings set org.mate.background picture-options 'zoom' 2>/dev/null || true
fi

# Keep applications that support MATE's dark preference aligned with the
# selected metatheme. Brisk is the principal consumer on this desktop.
if gsettings writable com.solus-project.brisk-menu dark-theme >/dev/null 2>&1; then
    gsettings set com.solus-project.brisk-menu dark-theme "${dark,,}" 2>/dev/null || true
fi

# Toolkit-level dark preference. GTK apps that honor the GNOME/MATE color
# scheme (LibreOffice via the gtk3 VCL plugin, Qt apps via their GTK theme)
# follow the metatheme instead of staying bright on a dark theme.
if gsettings writable org.gnome.desktop.interface color-scheme >/dev/null 2>&1; then
    if [ "$dark" = True ]; then
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
    else
        gsettings set org.gnome.desktop.interface color-scheme 'default' 2>/dev/null || true
    fi
fi

# MATE Terminal does not reliably follow a metatheme's text colors. Keep its
# default profile explicitly readable whenever the user changes a Spaced theme.
terminal_profile='org.mate.terminal.profile:/org/mate/terminal/profiles/default/'
if [ "$dark" = True ]; then
    terminal_background='#000000'
    terminal_foreground='#888888'
else
    terminal_background='#ffffff'
    terminal_foreground='#000000'
fi
if gsettings writable "$terminal_profile" foreground-color >/dev/null 2>&1; then
    gsettings set "$terminal_profile" use-theme-colors false 2>/dev/null || true
    gsettings set "$terminal_profile" background-color "$terminal_background" 2>/dev/null || true
    gsettings set "$terminal_profile" foreground-color "$terminal_foreground" 2>/dev/null || true
fi

# All layouts use one stable panel. Move and resize that panel in place; never
# replace mate-panel, which can lose the notification-area X selection.
gsettings set org.mate.panel default-layout "$panel_layout" 2>/dev/null || true
for id in bottom top; do
    schema="org.mate.panel.toplevel:/org/mate/panel/toplevels/$id/"
    gsettings list-keys "$schema" >/dev/null 2>&1 || continue
    gsettings set "$schema" orientation "$panel_position" 2>/dev/null || true
    gsettings set "$schema" size "$panel_size" 2>/dev/null || true
    background_schema="${schema}background/"
    if [ -n "$panel_color" ]; then
        gsettings set "$background_schema" type 'color' 2>/dev/null || true
        gsettings set "$background_schema" color "$panel_color" 2>/dev/null || true
        gsettings set "$background_schema" opacity 65535 2>/dev/null || true
    else
        gsettings set "$background_schema" type 'none' 2>/dev/null || true
    fi
    if [ "$panel_position" = top ]; then
        gsettings set "$schema" y 0 2>/dev/null || true
        gsettings set "$schema" y-bottom -1 2>/dev/null || true
    else
        gsettings set "$schema" y -1 2>/dev/null || true
        gsettings set "$schema" y-bottom 0 2>/dev/null || true
    fi
done

if [ "$cairo_dock" = True ]; then
    if command -v cairo-dock >/dev/null 2>&1 && ! pgrep -u "$(id -u)" -x cairo-dock >/dev/null; then
        dock_config=${XDG_CONFIG_HOME:-$HOME/.config}/cairo-dock
        default_theme=/usr/share/cairo-dock/themes/Default-Single
        if [ ! -d "$dock_config/current_theme" ] && [ -d "$default_theme" ]; then
            rm -f "$dock_config/current_theme"
            mkdir -p "$dock_config/current_theme"
            cp -a "$default_theme/." "$dock_config/current_theme/"
        fi
        if [ -d "$dock_config/current_theme" ] && \
           [ ! -e "$dock_config/current_theme/.spaced-launchers-v1" ]; then
            rm -rf "$dock_config/current_theme/launchers"
            mkdir -p "$dock_config/current_theme/launchers"
            cp -a /usr/share/spaced-themes/cairo-dock/launchers/. \
                "$dock_config/current_theme/launchers/"
            touch "$dock_config/current_theme/.spaced-launchers-v1"
        fi
        if [ -f "$dock_config/current_theme/cairo-dock.conf" ]; then
            sed -i -e 's/^modules=.*/modules=/' \
                -e 's/^visibility=.*/visibility=0/' \
                "$dock_config/current_theme/cairo-dock.conf"
        fi
        # The software backend avoids the black/error overlay seen with forced
        # OpenGL under QEMU while remaining lighter than a full dock plug-in set.
        cairo-dock -c -f -a -d "$dock_config" >/dev/null 2>&1 8>&- &
    fi
else
    pkill -u "$(id -u)" -x cairo-dock 2>/dev/null || true
fi

# Sandboxed GTK apps (Flatpaks, Bazaar, VLC) receive the active theme NAME via
# the session's XSettings, but their sandboxes can only resolve the theme FILES
# when they are exported to the host theme export directory and Flatpak is
# granted read access. Real copies are required because symlinks to
# /usr/share/themes do not survive into the sandbox namespace; refresh them on
# every switch so package upgrades keep the sandboxes in sync.
if command -v flatpak >/dev/null 2>&1; then
    theme_export=${XDG_DATA_HOME:-$HOME/.local/share}/themes
    mkdir -p "$theme_export"
    # The exported copy is the same for every theme, so it only has to be
    # rebuilt when the installed theme packages change. Copying 11 theme trees
    # on each switch was the single most expensive part of a theme change.
    stamp_file="$theme_export/.spaced-export-stamp"
    stamp=$(find /usr/share/themes -maxdepth 1 -name 'Spaced-*' -printf '%f %T@\n' \
        2>/dev/null | sort | cksum)
    if [ "$stamp" != "$(cat "$stamp_file" 2>/dev/null || true)" ]; then
        for theme_dir in /usr/share/themes/Spaced-*; do
            [ -d "$theme_dir" ] || continue
            rsync -a --delete "$theme_dir/" "$theme_export/${theme_dir##*/}/" 2>/dev/null \
                || true
        done
        flatpak override --user --filesystem=xdg-data/themes:ro >/dev/null 2>&1 || true
        printf '%s\n' "$stamp" >"$stamp_file" 2>/dev/null || true
    fi
    # `flatpak override` rewrites every application's override file, so skip it
    # unless the theme name a sandbox would see has actually changed.
    theme_stamp="$theme_export/.spaced-gtk-theme"
    if [ "$gtk_theme" != "$(cat "$theme_stamp" 2>/dev/null || true)" ]; then
        flatpak override --user --env="GTK_THEME=$gtk_theme" >/dev/null 2>&1 || true
        printf '%s\n' "$gtk_theme" >"$theme_stamp" 2>/dev/null || true
    fi
fi

logger -t spaced-switch-theme "Applied desktop extras for $name"

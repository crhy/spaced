#!/bin/bash
# PulseAudio normally restores sink state itself. Keep a small user-level copy
# as a fallback for hardware and virtual sinks that reappear muted or at 0%.
set -u
export LC_ALL=C

state_dir=${XDG_CONFIG_HOME:-$HOME/.config}/spaced
state_file=$state_dir/audio-state
profile_state_file=$state_dir/audio-card-profiles
unavailable_default=''

wait_for_pulse() {
    local attempt
    for attempt in {1..30}; do
        pactl info >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

read_current() {
    local sink volume mute
    sink=$(pactl get-default-sink 2>/dev/null || true)
    case "$sink" in ''|auto_null) return 1 ;; esac
    volume=$(pactl get-sink-volume "$sink" 2>/dev/null |
        awk 'match($0, /[0-9]+%/) {print substr($0, RSTART, RLENGTH-1); exit}')
    mute=$(pactl get-sink-mute "$sink" 2>/dev/null | awk '{print $2; exit}')
    [[ "$volume" =~ ^[0-9]+$ ]] || return 1
    case "$mute" in yes|no) ;; *) return 1 ;; esac
    printf '%s %s %s\n' "$volume" "$mute" "$sink"
}

valid_profile_token() {
    [[ "$1" =~ ^[A-Za-z0-9_.:+-]+$ ]]
}

read_current_profiles() {
    local cards
    cards=$(pactl list cards 2>/dev/null) || return 1
    awk '
        /^[[:space:]]*Name: / { card=$2 }
        /^[[:space:]]*Active Profile: / && card != "" {
            profile=$3
            if (profile != "off") print card, profile
            card=""
        }
    ' <<< "$cards"
}

restore_profiles() {
    local card profile
    [ -r "$profile_state_file" ] || return 0
    while read -r card profile extra; do
        [ -z "${extra:-}" ] || continue
        valid_profile_token "$card" || continue
        valid_profile_token "$profile" || continue
        pactl set-card-profile "$card" "$profile" >/dev/null 2>&1 || true
    done < "$profile_state_file"
}

save_profiles() {
    local card profile extra current temporary
    declare -A profiles=()
    if [ -r "$profile_state_file" ]; then
        while read -r card profile extra; do
            [ -z "${extra:-}" ] || continue
            valid_profile_token "$card" || continue
            valid_profile_token "$profile" || continue
            profiles["$card"]=$profile
        done < "$profile_state_file"
    fi
    current=$(read_current_profiles) || return 0
    while read -r card profile extra; do
        [ -n "$card" ] || continue
        [ -z "${extra:-}" ] || continue
        valid_profile_token "$card" || continue
        valid_profile_token "$profile" || continue
        profiles["$card"]=$profile
    done <<< "$current"
    ((${#profiles[@]})) || return 0
    mkdir -p "$state_dir" || return 0
    temporary=$profile_state_file.tmp
    for card in "${!profiles[@]}"; do
        printf '%s %s\n' "$card" "${profiles[$card]}"
    done | sort > "$temporary" || return 0
    mv "$temporary" "$profile_state_file"
}

save_current() {
    local current temporary volume mute sink
    current=$(read_current) || return 0
    read -r volume mute sink <<< "$current"
    if [ -n "$unavailable_default" ]; then
        [ "$sink" != "$unavailable_default" ] || return 0
        unavailable_default=''
    fi
    mkdir -p "$state_dir" || return 0
    temporary=$state_file.tmp
    printf '%s\n' "$current" > "$temporary" || return 0
    mv "$temporary" "$state_file"
}

save_state() {
    save_current
    save_profiles
}

command -v pactl >/dev/null 2>&1 || exit 0
wait_for_pulse || exit 0

# A card profile controls physical modes such as analog versus S/PDIF. Apply
# it before restoring the default sink because changing profile can replace
# the card's sinks. Missing USB cards remain recorded and are retried when a
# card appears later in the session.
restore_profiles

if { read -r saved_volume saved_mute saved_sink < "$state_file"; } 2>/dev/null \
    && [[ "$saved_volume" =~ ^[0-9]+$ ]] \
    && [[ "$saved_mute" =~ ^(yes|no)$ ]]; then
    if [ -z "$saved_sink" ] || pactl set-default-sink "$saved_sink" >/dev/null 2>&1; then
        target=${saved_sink:-@DEFAULT_SINK@}
        pactl set-sink-volume "$target" "$saved_volume%" >/dev/null 2>&1 || true
        [ "$saved_mute" = yes ] && mute=1 || mute=0
        pactl set-sink-mute "$target" "$mute" >/dev/null 2>&1 || true
    else
        unavailable_default=$(pactl get-default-sink 2>/dev/null) || exit 0
        [ -n "$unavailable_default" ] || exit 0
    fi
else
    read -r current_volume current_mute current_sink < <(read_current) || exit 0
    # Start a new profile at 50%. Later logins restore the saved choice,
    # including intentional mute and zero volume.
    if [ "$current_volume" -ne 50 ]; then
        pactl set-sink-volume @DEFAULT_SINK@ 50% >/dev/null 2>&1 || true
    fi
    if [ "$current_mute" = yes ]; then
        pactl set-sink-mute @DEFAULT_SINK@ 0 >/dev/null 2>&1 || true
    fi
fi
save_state
trap 'save_state; exit 0' HUP INT TERM

# Dragging a volume slider emits a stream of sink events. Saving on each one
# spawns three pactl processes per event; wait for the burst to settle first.
SETTLE_SECONDS=${SPACED_AUDIO_SETTLE_SECONDS:-1}
pending=''
restore_pending=''
while :; do
    if [ -n "$pending" ]; then
        IFS= read -r -t "$SETTLE_SECONDS" event
    else
        IFS= read -r event
    fi
    status=$?
    if [ "$status" -eq 0 ]; then
        case "$event" in
            *"'new' on card "*) pending=1; restore_pending=1 ;;
            *" on card "*) pending=1 ;;
            *" on sink "*|*" on server "*) pending=1 ;;
        esac
        continue
    fi
    # A status above 128 is the read timing out, which means the burst has
    # settled. Anything else is end-of-stream: save once more and stop.
    if [ -n "$pending" ]; then
        [ -n "$restore_pending" ] && restore_profiles
        save_state
        pending=''
        restore_pending=''
    fi
    [ "$status" -gt 128 ] || break
done < <(pactl subscribe 2>/dev/null)

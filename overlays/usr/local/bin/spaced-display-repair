#!/bin/bash
# Keep the X server's own display power state consistent with MATE's policy,
# and disable driver-side TV underscan, after login and after unlock.
#
# MATE's settings daemon alone owns modes, refresh rates, positions, rotation,
# transforms and panning. Replaying a snapshot here races Monitor Preferences
# and can undo a newly saved multi-monitor or 4K configuration.
set -u

repair_outputs() {
    local output property value
    # `xset dpms force on` calls DPMSEnable, overriding Power Management's
    # Never/disabled choice. Input already wakes X; leave power policy to MATE.
    while IFS='|' read -r output property value; do
        xrandr --output "$output" --set "$property" "$value" >/dev/null 2>&1 || true
    done < <(xrandr --prop 2>/dev/null | awk '
        /^[^[:space:]]/ {
            output=""
            if ($2 == "connected")
                for (i=3; i<=NF; i++)
                    if ($i ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/)
                        output=$1
            next
        }
        output != "" && $1 == "underscan:" && $2 == "on" {
            print output "|underscan|off"
        }
        output != "" && $1 == "underscan" && $2 ~ /^[hv]border:$/ && $3 + 0 != 0 {
            sub(/:$/, "", $2)
            print output "|underscan " $2 "|0"
        }
    ')
}

# Issue #178: choosing "Never" for display sleep did not keep the monitors on.
# MATE writes 0 for Never and then simply stops programming a timeout, which
# leaves the X server's *own* defaults in force: DPMS still powers the outputs
# down and the built-in screen saver still blanks them after ten minutes. Only
# turning both off in the X server actually honours the user's choice.
on_battery() {
    local supply type online
    for supply in /sys/class/power_supply/*; do
        [ -r "$supply/type" ] || continue
        IFS= read -r type < "$supply/type" || continue
        [ "$type" = Mains ] || continue
        [ -r "$supply/online" ] || continue
        IFS= read -r online < "$supply/online" || continue
        [ "$online" = 0 ] && return 0
        return 1
    done
    # No mains supply is reported: treat the machine as a desktop on AC.
    return 1
}

display_sleep_timeout() {
    local key=sleep-display-ac
    on_battery && key=sleep-display-battery
    gsettings get org.mate.power-manager "$key" 2>/dev/null |
        awk '{gsub(/[^0-9-]/, "", $NF); print $NF + 0; exit}'
}

# Issue #189: choosing "Never" still let the screen go dark after five minutes.
# The display-sleep choice only governs mate-power-manager, and it does honour
# 0 correctly -- with no blank timeout it never enters its BLANK mode and never
# touches DPMS. The screen was going dark because mate-screensaver activates on
# its own schedule, at org.mate.session's idle-delay, which MATE defaults to
# five minutes. That blanks and locks regardless of the power policy, and no
# control in Power Preferences can reach it, so "Never" has never meant never.
# Suppress idle activation while Never is selected and put the user's own
# choice back when a real timeout returns.
screensaver_state="${XDG_CONFIG_HOME:-$HOME/.config}/spaced/screensaver-idle-activation"

have_screensaver() {
    gsettings list-schemas 2>/dev/null | grep -qx org.mate.screensaver
}

suspend_screensaver_idle() {
    local current
    have_screensaver || return 0
    current=$(gsettings get org.mate.screensaver idle-activation-enabled 2>/dev/null)
    # Already off, whether by our own doing or the user's: leave it and keep
    # any saved value, so a restore still returns what the user chose.
    [ "$current" = false ] && return 0
    mkdir -p "${screensaver_state%/*}" 2>/dev/null || true
    printf '%s\n' "$current" > "$screensaver_state" 2>/dev/null || true
    gsettings set org.mate.screensaver idle-activation-enabled false 2>/dev/null || true
}

restore_screensaver_idle() {
    local saved
    have_screensaver || return 0
    # No saved value means Never was never applied here; never turn on a
    # screensaver the user had deliberately switched off.
    [ -r "$screensaver_state" ] || return 0
    IFS= read -r saved < "$screensaver_state" || saved=true
    rm -f "$screensaver_state" 2>/dev/null || true
    [ "$saved" = false ] && return 0
    gsettings set org.mate.screensaver idle-activation-enabled true 2>/dev/null || true
}

apply_power_policy() {
    local timeout
    gsettings list-schemas 2>/dev/null | grep -qx org.mate.power-manager || return 0
    timeout=$(display_sleep_timeout)
    [ -n "$timeout" ] || return 0
    if [ "$timeout" -le 0 ]; then
        # Never: no blanking, no DPMS, no matter what X defaulted to.
        xset -dpms 2>/dev/null || true
        xset s off 2>/dev/null || true
        xset s noblank 2>/dev/null || true
        suspend_screensaver_idle
    else
        # A real timeout was chosen. Hand DPMS back to mate-power-manager
        # rather than programming a competing timeout here.
        xset +dpms 2>/dev/null || true
        restore_screensaver_idle
    fi
}

[ -n "${DISPLAY:-}" ] || exit 0
command -v xrandr >/dev/null 2>&1 || exit 0
repair_outputs
command -v xset >/dev/null 2>&1 && apply_power_policy

[ "${1:-}" = --watch ] || exit 0

# Re-apply whenever the user changes the power policy, so "Never" takes effect
# immediately instead of at the next login.
policy_watchers=()
if command -v gsettings >/dev/null 2>&1 && command -v xset >/dev/null 2>&1 \
    && gsettings list-schemas 2>/dev/null | grep -qx org.mate.power-manager; then
    for key in sleep-display-ac sleep-display-battery; do
        while IFS= read -r _; do
            apply_power_policy
        done < <(gsettings monitor org.mate.power-manager "$key" 2>/dev/null) &
        policy_watchers+=("$!")
    done
    trap 'kill "${policy_watchers[@]}" 2>/dev/null || true' EXIT
fi

command -v gdbus >/dev/null 2>&1 || exit 0
gdbus monitor --session --dest org.mate.ScreenSaver \
    --object-path /org/mate/ScreenSaver 2>/dev/null |
while IFS= read -r event; do
    case "$event" in
        *'ActiveChanged (false,'*)
            repair_outputs
            command -v xset >/dev/null 2>&1 && apply_power_policy
            ;;
    esac
done

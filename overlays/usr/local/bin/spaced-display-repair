#!/bin/bash
# Reassert the active XRandR state after login and screensaver unlock. This
# clears stale virtual-GPU scanout state and disables driver-side TV underscan
# without changing the user's chosen resolution.
set -u

repair_outputs() {
    local output mode rate properties
    xset dpms force on >/dev/null 2>&1 || true
    while read -r output mode rate; do
        [ -n "$output" ] || continue
        properties=$(xrandr --prop 2>/dev/null | awk -v wanted="$output" '
            $1 == wanted && $2 == "connected" {inside=1; next}
            /^[^[:space:]]/ {inside=0}
            inside {print}
        ')
        if grep -q '^[[:space:]]*underscan:' <<<"$properties"; then
            xrandr --output "$output" --set underscan off >/dev/null 2>&1 || true
        fi
        if grep -q '^[[:space:]]*underscan hborder:' <<<"$properties"; then
            xrandr --output "$output" --set 'underscan hborder' 0 >/dev/null 2>&1 || true
        fi
        if grep -q '^[[:space:]]*underscan vborder:' <<<"$properties"; then
            xrandr --output "$output" --set 'underscan vborder' 0 >/dev/null 2>&1 || true
        fi
        if grep -q '^[[:space:]]*Broadcast RGB:' <<<"$properties"; then
            xrandr --output "$output" --set 'Broadcast RGB' Full >/dev/null 2>&1 || true
        fi
        rate=${rate//[^0-9.]/}
        if [ -n "$rate" ]; then
            xrandr --output "$output" --mode "$mode" --rate "$rate" >/dev/null 2>&1 || true
        else
            xrandr --output "$output" --mode "$mode" >/dev/null 2>&1 || true
        fi
    done < <(xrandr --query 2>/dev/null | awk '
        $2 == "connected" {output=$1; next}
        output != "" && /\*/ {print output, $1, $2; output=""}
    ')
}

[ -n "${DISPLAY:-}" ] || exit 0
command -v xrandr >/dev/null 2>&1 || exit 0
repair_outputs

[ "${1:-}" = --watch ] || exit 0
command -v gdbus >/dev/null 2>&1 || exit 0
gdbus monitor --session --dest org.mate.ScreenSaver \
    --object-path /org/mate/ScreenSaver 2>/dev/null |
while IFS= read -r event; do
    case "$event" in
        *'ActiveChanged (false,'*) repair_outputs ;;
    esac
done

#!/usr/bin/python3
"""Return desktop icons that are stored outside every monitor.

Caja remembers an explicit position for each desktop icon. When a display is
removed, or a multi-monitor layout is rearranged, positions saved against the
old geometry can land beyond the visible area: the icon still exists and Caja
still draws it, just nowhere the user can see. Issue #184 reported Gigolo's
network shares vanishing from the desktop, and issue #180 recorded the same
icons reappearing the moment a fifth monitor extended the desktop far enough
to cover their saved coordinates.

Clearing only the unreachable positions makes Caja auto-place those icons on
the next desktop refresh. Positions that are still on screen are never
touched, so a deliberately arranged desktop survives. The watcher also
repairs positions created after login, including late Caja startup metadata
and files downloaded onto the desktop (issues #407 and #412).
"""

import configparser
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

POSITION_KEY = "caja-icon-position"
METADATA_ATTRIBUTE = f"metadata::{POSITION_KEY}"
MODE_PATTERN = re.compile(r"\b(\d+)x(\d+)\+(-?\d+)\+(-?\d+)\b")
DESKTOP_DIR_PATTERN = re.compile(r"^\s*XDG_DESKTOP_DIR=(.*)\s*$")
CARDINAL_PATTERN = re.compile(r"=\s*(-?\d+(?:\s*,\s*-?\d+)*)\s*$")


def run(command):
    try:
        result = subprocess.run(
            command, capture_output=True, text=True, timeout=20, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout if result.returncode == 0 else None


def screen_rectangles():
    """Active CRTC rectangles, as (x, y, width, height)."""
    output = run(["xrandr", "--query"])
    if not output:
        return []
    rectangles = []
    for line in output.splitlines():
        if line[:1].isspace() or " connected" not in line:
            continue
        match = MODE_PATTERN.search(line)
        if match:
            width, height, x, y = (int(value) for value in match.groups())
            if width > 0 and height > 0:
                rectangles.append((x, y, width, height))
    return rectangles


def usable_rectangles(rectangles):
    """Intersect connected screens with the desktop's EWMH work area.

    Caja must not place icons underneath a panel.  XRandR only describes the
    physical monitor bounds, while the window manager publishes the usable
    desktop (excluding panels and docks) through ``_NET_WORKAREA``.
    """
    output = run(["xprop", "-root", "_NET_CURRENT_DESKTOP", "_NET_WORKAREA"])
    if not output:
        return rectangles
    current = 0
    workarea_values = []
    for line in output.splitlines():
        match = CARDINAL_PATTERN.search(line)
        if not match:
            continue
        values = [int(value.strip()) for value in match.group(1).split(",")]
        if line.startswith("_NET_CURRENT_DESKTOP") and len(values) == 1:
            current = values[0]
        elif line.startswith("_NET_WORKAREA"):
            workarea_values = values
    offset = current * 4
    if current < 0 or len(workarea_values) < offset + 4:
        return rectangles
    work_left, work_top, work_width, work_height = workarea_values[offset:offset + 4]
    if work_width <= 0 or work_height <= 0:
        return rectangles
    work_right = work_left + work_width
    work_bottom = work_top + work_height
    usable = []
    for left, top, width, height in rectangles:
        right, bottom = left + width, top + height
        clipped_left, clipped_top = max(left, work_left), max(top, work_top)
        clipped_right, clipped_bottom = min(right, work_right), min(bottom, work_bottom)
        if clipped_right > clipped_left and clipped_bottom > clipped_top:
            usable.append((clipped_left, clipped_top,
                           clipped_right - clipped_left,
                           clipped_bottom - clipped_top))
    return usable or rectangles


def reachable(position, rectangles):
    """True when a stored icon position falls inside usable desktop space."""
    try:
        x_text, y_text = position.split(",", 1)
        x, y = int(x_text.strip()), int(y_text.strip())
    except (AttributeError, ValueError):
        # An unparseable position cannot be validated; leave it alone.
        return True
    for left, top, width, height in rectangles:
        if left <= x < left + width and top <= y < top + height:
            return True
    return False


def repair_file_icons(desktop, rectangles):
    """Clear stranded positions Caja stored in gvfs metadata for real files."""
    repaired = []
    if not shutil.which("gio") or not desktop.is_dir():
        return repaired
    for entry in sorted(desktop.iterdir()):
        info = run(["gio", "info", "-a", METADATA_ATTRIBUTE, str(entry)])
        if not info:
            continue
        position = None
        prefix = f"{METADATA_ATTRIBUTE}:"
        for line in info.splitlines():
            stripped = line.strip()
            # The attribute name itself contains "::", so trim the known
            # prefix rather than splitting on the first colon.
            if stripped.startswith(prefix):
                position = stripped[len(prefix):].strip()
                break
        if position is None or reachable(position, rectangles):
            continue
        if run(["gio", "set", "-t", "unset", str(entry), METADATA_ATTRIBUTE]) is not None:
            repaired.append(entry.name)
    return repaired


def repair_desktop_metadata(path, rectangles):
    """Clear stranded positions for volumes, trash, and other non-file items."""
    if not path.is_file():
        return []
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    try:
        parser.read_string(path.read_text(encoding="utf-8", errors="replace"))
    except configparser.Error:
        return []
    repaired = []
    for section in parser.sections():
        position = parser[section].get(POSITION_KEY)
        if position is None or reachable(position, rectangles):
            continue
        parser.remove_option(section, POSITION_KEY)
        repaired.append(section)
    if not repaired:
        return []
    handle, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            parser.write(stream, space_around_delimiters=False)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return repaired


def desktop_directory(config):
    """Return the user's XDG desktop directory, including custom locations."""
    configured = os.environ.get("XDG_DESKTOP_DIR")
    if configured:
        return Path(os.path.expandvars(os.path.expanduser(configured)))

    user_dirs = config / "user-dirs.dirs"
    try:
        lines = user_dirs.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        lines = []
    for line in lines:
        match = DESKTOP_DIR_PATTERN.match(line)
        if not match:
            continue
        value = match.group(1).strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        value = value.replace(r"\040", " ")
        value = value.replace("${HOME}", str(Path.home())).replace("$HOME", str(Path.home()))
        return Path(os.path.expandvars(os.path.expanduser(value)))
    return Path.home() / "Desktop"


def watched_directories(config):
    """Directories whose changes can introduce a newly stranded icon."""
    return (desktop_directory(config), config / "caja")


def watch():
    """Repair after monitor, desktop-file, or Caja metadata changes."""
    import gi

    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gio, GLib

    display = Gdk.Display.get_default()
    if display is None:
        return repair_once()
    screen = display.get_default_screen()
    loop = GLib.MainLoop()
    pending = 0
    monitors = []

    def settle():
        nonlocal pending
        pending = 0
        repair_once()
        return GLib.SOURCE_REMOVE

    def schedule(delay):
        # Rearranging monitors, downloading a file, and Caja updating its
        # metadata can each emit a burst. Run once after the burst settles.
        nonlocal pending
        if pending:
            GLib.source_remove(pending)
        pending = GLib.timeout_add_seconds(delay, settle)

    def layout_changed(*_args):
        schedule(3)

    def icon_changed(*_args):
        schedule(2)

    screen.connect("size-changed", layout_changed)
    screen.connect("monitors-changed", layout_changed)

    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    for directory in watched_directories(config):
        if not directory.is_dir():
            continue
        try:
            monitor = Gio.File.new_for_path(str(directory)).monitor_directory(
                Gio.FileMonitorFlags.NONE, None)
        except GLib.Error:
            continue
        monitor.connect("changed", icon_changed)
        monitors.append(monitor)

    repair_once()
    loop.run()
    return 0


def repair_once():
    rectangles = screen_rectangles()
    if not rectangles:
        # Without a trustworthy layout, doing nothing is the safe choice.
        return 0
    rectangles = usable_rectangles(rectangles)
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    desktop = desktop_directory(config)
    repaired = repair_file_icons(desktop, rectangles)
    repaired += repair_desktop_metadata(config / "caja" / "desktop-metadata", rectangles)
    if repaired:
        print("Re-placed desktop icons stored off screen: " + ", ".join(repaired))
    return 0


def main():
    if not os.environ.get("DISPLAY"):
        return 0
    if "--watch" in sys.argv[1:]:
        return watch()
    return repair_once()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as error:
        print(f"Desktop icon repair skipped: {error}", file=sys.stderr)
        sys.exit(0)

#!/bin/bash
# Register signed application sources for the current user.
set -u

real_flatpak=/usr/bin/flatpak
remote_dir=/usr/share/flatpak/remotes.d

[[ -x $real_flatpak ]] || exit 0

remote_present() {
    "$real_flatpak" remotes --user --columns=name 2>/dev/null |
        grep -Fxq "$1"
}

add_missing_remotes() {
    local missing=0 name registered=''

    for name in flathub spaced-github; do
        if remote_present "$name"; then
            registered="$registered $name"
            continue
        fi
        missing=1
        if "$real_flatpak" remote-add --user --if-not-exists "$name" \
            "$remote_dir/$name.flatpakrepo" >/dev/null 2>&1; then
            # --if-not-exists only fails when the remote really is absent.
            registered="$registered $name"
        fi
    done

    # Reuse what the loop already learned. The old final check started the
    # flatpak CLI twice more on every login, and nine more times per retry
    # round on a machine that never gets network.
    for name in flathub spaced-github; do
        [[ " $registered " == *" $name "* ]] || return "$missing"
    done
    return 0
}

# NetworkManager may still be connecting when desktop autostart runs. Flatpak
# can import each bundled signing key locally, while retries cover the initial
# repository-summary fetch on a new installation.
# Back off instead of polling every two seconds for three minutes. A machine
# that is simply offline used to run this loop ninety times, spawning several
# flatpak processes each round for no possible gain.
delay=2
elapsed=0
while [ "$elapsed" -lt 180 ]; do
    add_missing_remotes && exit 0
    sleep "$delay"
    elapsed=$((elapsed + delay))
    [ "$delay" -lt 30 ] && delay=$((delay * 2))
    [ "$delay" -gt 30 ] && delay=30
done

logger -t spaced-enable-flatpak-remotes \
    "Flathub or spaced-github could not be registered during login"
exit 1

#!/bin/bash
set -u
marker="$HOME/.config/spaced/first-login-repair-v5"
[ -e "$marker" ] && exit 0
mkdir -p "$(dirname "$marker")"
# Make GTK-aware applications, including LibreOffice, follow the selected desktop theme.
export SAL_USE_VCLPLUGIN=gtk3
# Refresh user-level MIME defaults on upgraded profiles without replacing
# unrelated choices. Caja then treats shell scripts consistently in Desktop
# and ordinary subdirectories.
if command -v xdg-mime >/dev/null 2>&1; then
  xdg-mime default pluma.desktop text/plain || true
  xdg-mime default pluma.desktop text/x-shellscript || true
  xdg-mime default pluma.desktop application/x-shellscript || true
fi
# Caja's Ctrl-H view toggle was not retained by existing 8.26.5 profiles.
# Apply the requested visible-hidden-files state once during this migration;
# subsequent user changes remain ordinary persistent dconf choices.
if command -v gsettings >/dev/null 2>&1 \
    && gsettings list-schemas 2>/dev/null | grep -qx org.mate.caja.preferences; then
  gsettings set org.mate.caja.preferences show-hidden-files true || true
fi
# Repair only missing canonical applets. Package upgrades do not cause MATE to
# merge a newer layout into an existing dconf profile, which left upgraded
# systems without the volume applet. Avoid a full panel reset so user-added
# launchers and placement survive.
if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas | grep -qx org.mate.panel; then
  objects=$(gsettings get org.mate.panel object-id-list 2>/dev/null || printf '[]')
  toplevels=$(gsettings get org.mate.panel toplevel-id-list 2>/dev/null || printf '[]')
  case "$toplevels" in
    *"'bottom'"*) panel=bottom ;;
    *"'top'"*) panel=top ;;
    *) panel=bottom ;;
  esac

  canonical_applets=(
    'brisk-menu|BriskMenuFactory::BriskMenu|0|false'
    'window-list|WnckletFactory::WindowListApplet|20|false'
    'notification-area|NotificationAreaAppletFactory::NotificationArea|60|true'
    'volume-control-applet|GvcAppletFactory::GvcApplet|63|true'
    'clock|ClockAppletFactory::ClockApplet|66|true'
    'show-desktop|WnckletFactory::ShowDesktopApplet|0|true'
  )
  missing=()
  for applet in "${canonical_applets[@]}"; do
    IFS='|' read -r id iid position right_stick <<<"$applet"
    base="org.mate.panel.object:/org/mate/panel/objects/$id/"
    configured_iid=$(gsettings get "$base" applet-iid 2>/dev/null || printf "''")
    if [[ "$objects" != *"'$id'"* ]] || [ "$configured_iid" != "'$iid'" ]; then
      gsettings set "$base" object-type 'applet' || true
      gsettings set "$base" toplevel-id "$panel" || true
      gsettings set "$base" position "$position" || true
      gsettings set "$base" panel-right-stick "$right_stick" || true
      gsettings set "$base" applet-iid "$iid" || true
      missing+=("$id")
    fi
  done

  if [ "${#missing[@]}" -gt 0 ]; then
    repaired_objects=$(python3 - "$objects" "${missing[@]}" <<'PY'
import ast
import sys

serialized = sys.argv[1]
if serialized.startswith("@as "):
    serialized = serialized[4:]
objects = ast.literal_eval(serialized)
for object_id in sys.argv[2:]:
    if object_id not in objects:
        objects.append(object_id)
print(repr(objects))
PY
    )
    gsettings set org.mate.panel object-id-list "$repaired_objects" || true
  fi
fi
# Apply automatic scaling and always leave the window-scaling factor explicit:
# standard (96 DPI) displays get exactly 100%, and genuinely high-density
# displays get 2x. An unset or leftover factor would otherwise make dialogs
# inconsistent after a theme change or an upgraded profile.
if command -v xdpyinfo >/dev/null 2>&1; then
  dpi=$(xdpyinfo 2>/dev/null | awk '/resolution:/{gsub(/x.*/,"",$2); print int($2); exit}')
  if [ "${dpi:-0}" -ge 150 ]; then
    gsettings set org.mate.interface window-scaling-factor 2 2>/dev/null || true
    gsettings set org.mate.interface text-scaling-factor 1.15 2>/dev/null || true
  else
    gsettings set org.mate.interface window-scaling-factor 1 2>/dev/null || true
  fi
fi
# Re-assert the selected theme values after Calamares creates the account.
for schema in org.mate.interface; do
  gsettings list-schemas 2>/dev/null | grep -qx "$schema" || continue
  gsettings get "$schema" gtk-theme >/dev/null 2>&1 || true
done
touch "$marker"

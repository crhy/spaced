#!/bin/bash
# Read-only diagnostics; run in the desktop session to inspect its displays.
set -u
export LC_ALL=C
run() {
    printf '\n--- %s ---\n' "$*"
    if command -v "$1" >/dev/null 2>&1; then
        timeout --kill-after=2 15 "$@" 2>&1 || printf 'Check unavailable (status %s).\n' "$?"
    else
        printf '%s is not installed.\n' "$1"
    fi
}
run uname -r
run cat /proc/cmdline
run lspci -nnk
run lsusb
run lsmod
run glxinfo -B
run xrandr --listproviders
run xrandr --verbose
run xset q
run xdpyinfo
run xrdb -query
run xprop -root _NET_SUPPORTING_WM_CHECK _NET_ACTIVE_WINDOW
for schema in org.mate.interface org.mate.font-rendering org.mate.power-manager org.mate.session org.mate.screensaver; do
    run gsettings list-recursively "$schema"
done
run ps -C compiz,gtk-window-decorator,mate-settings-daemon,mate-power-manager,mate-screensaver -o pid,ppid,etimes,stat,comm
printf '\n--- Saved screensaver idle preference ---\n'
state="${XDG_CONFIG_HOME:-$HOME/.config}/spaced/screensaver-idle-activation"
if [ -r "$state" ]; then
    head -c 64 "$state"
else
    printf 'No saved override.\n'
fi
run dpkg-query -W '-f=${binary:Package} ${Version}\n' firmware-amd-graphics firmware-realtek firmware-mediatek libgl1-mesa-dri mesa-vulkan-drivers xserver-xorg-video-amdgpu amdgpu-top
run mokutil --sb-state
if command -v nvidia-smi >/dev/null 2>&1; then
    run nvidia-smi --query-gpu=pci.bus_id,name,driver_version --format=csv
    run env __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia glxinfo -B
    run dkms status
fi
printf '\n--- AMDGPU TearFree configuration ---\n'
if [[ -f /etc/X11/xorg.conf.d/20-spaced-amdgpu.conf ]]; then
    cat /etc/X11/xorg.conf.d/20-spaced-amdgpu.conf
else
    echo 'Spaced AMDGPU TearFree default is not installed.'
fi
printf '\n--- Recent kernel graphics / firmware errors ---\n'
dmesg 2>&1 | grep -Ei 'amdgpu|nouveau|nvidia|firmware|failed|error' | tail -80
printf '\nKernel logs may require administrator access. No system settings were changed.\n'

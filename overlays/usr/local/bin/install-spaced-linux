#!/bin/bash
# Launch Calamares safely from the live desktop without Debian-facing branding.
set -u

saved_fstab=0
if [ -f /etc/fstab ] && [ ! -e /etc/fstab.orig.calamares ]; then
    sudo mv /etc/fstab /etc/fstab.orig.calamares
    saved_fstab=1
fi

cleanup() {
    xhost -si:localuser:root >/dev/null 2>&1 || true
    if [ "$saved_fstab" -eq 1 ] && [ -f /etc/fstab.orig.calamares ]; then
        sudo mv /etc/fstab.orig.calamares /etc/fstab
    fi
}
trap cleanup EXIT INT TERM

xhost +si:localuser:root >/dev/null 2>&1 || true
# The live account's temporary NOPASSWD sudo rule is removed from the installed
# system by Calamares. pkexec cannot authorize reliably in the live MATE
# session, so preserve only the display/session variables Calamares needs.
# Force Qt Quick's software path for the installer: VirtualBox's emulated VMSVGA
# adapter can otherwise wedge the QML slideshow after the first page.
sudo --preserve-env=DISPLAY,XAUTHORITY,DBUS_SESSION_BUS_ADDRESS \
    env QT_AUTO_SCREEN_SCALE_FACTOR=1 \
        QT_QUICK_BACKEND=software \
        QSG_RHI_BACKEND=software \
        LIBGL_ALWAYS_SOFTWARE=1 \
        /usr/bin/calamares

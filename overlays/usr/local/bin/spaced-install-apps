#!/bin/bash
# Install Spaced Linux's suggested user Flatpaks without requiring root.
set -euo pipefail

mode=${1:-}
list=${SPACED_APP_LIST:-/usr/share/spaced-welcome/FlatpaksToInstallAfterInstall.txt}
bazaar_id=io.github.kolunmi.Bazaar

case "$mode" in
    suggested|bazaar) ;;
    *) echo "Usage: $0 {suggested|bazaar}" >&2; exit 2 ;;
esac

command -v flatpak >/dev/null 2>&1 || {
    echo "Flatpak is not installed." >&2
    exit 1
}

flatpak remote-add --user --if-not-exists flathub \
    https://flathub.org/repo/flathub.flatpakrepo

if [ "$mode" = bazaar ]; then
    refs=("$bazaar_id")
else
    [ -r "$list" ] || {
        echo "Suggested application list is missing." >&2
        exit 1
    }
fi

bundles=()
if [ "$mode" = suggested ]; then
    refs=()
    while IFS= read -r entry; do
        entry=${entry%%#*}
        entry=${entry//[[:space:]]/}
        [ -n "$entry" ] || continue
        case "$entry" in
            https://*) bundles+=("$entry") ;;
            *) refs+=("$entry") ;;
        esac
    done < "$list"
fi

failures=()
for ref in "${refs[@]}"; do
    installed=false
    for attempt in 1 2 3; do
        echo "Installing $ref (attempt $attempt of 3)…"
        if flatpak install --user -y flathub "$ref"; then
            installed=true
            break
        fi
        [ "$attempt" -eq 3 ] || sleep $((attempt * 2))
    done
    if [ "$installed" != true ]; then
        failures+=("$ref")
        echo "Could not install $ref; continuing with the remaining applications." >&2
    fi
done

if [ "${#bundles[@]}" -gt 0 ]; then
    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT
    for url in "${bundles[@]}"; do
        name=${url##*/}
        bundle="$tmpdir/$name"
        installed=false
        for attempt in 1 2 3; do
            echo "Downloading $name (attempt $attempt of 3)…"
            # --continue-at resumes an interrupted large bundle so a flaky
            # connection does not restart a multi-hundred-MB transfer.
            if curl --fail --location --retry 3 --retry-all-errors \
                --connect-timeout 15 --continue-at - --output "$bundle" "$url"; then
                if flatpak install --user -y "$bundle"; then
                    installed=true
                    break
                fi
                # The bundle is corrupt after a failed install; drop it so the
                # next attempt re-downloads cleanly instead of reusing it.
                rm -f "$bundle"
            fi
            [ "$attempt" -eq 3 ] || sleep $((attempt * 3))
        done
        if [ "$installed" != true ]; then
            failures+=("$url")
            echo "Could not install $name; continuing with the remaining applications." >&2
        fi
    done
fi

if [ "${#failures[@]}" -gt 0 ]; then
    printf 'The following applications could not be installed:\n' >&2
    printf '  %s\n' "${failures[@]}" >&2
    exit 1
fi

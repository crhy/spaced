#!/bin/bash
# Spaced Linux Compiz launcher.
# NVK currently exposes OpenGL through Zink, which can produce a black Compiz
# desktop. Use llvmpipe for that renderer and hardware acceleration elsewhere.

set -u

renderer=$(
    glxinfo -B 2>/dev/null |
    sed -n 's/^OpenGL renderer string:[[:space:]]*//p' |
    head -n1
)

renderer_lower=$(
    printf '%s' "$renderer" |
    tr '[:upper:]' '[:lower:]'
)

case "$renderer_lower" in
    *zink*|*nvk*)
        export LIBGL_ALWAYS_SOFTWARE=1
        logger -t spaced-window-manager \
          "Starting Compiz with software OpenGL: $renderer"
        ;;
    *)
        logger -t spaced-window-manager \
          "Starting Compiz with hardware OpenGL: $renderer"
        ;;
esac

exec compiz ccp --replace

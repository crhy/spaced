#!/usr/bin/env python3
# Calamares runs this as root when "Restart now" is ticked. It closes the live
# desktop first, then shows a blank screen asking for the USB medium to be
# removed, and reboots on any key press or click (issues #192 and #251).
#
# Everything the reboot needs is loaded before the prompt appears, because the
# live filesystem disappears with the USB medium. Calamares has already
# unmounted the installed target, so an immediate reboot loses nothing.
import ctypes
import os
import resource
import select
import signal
import struct
import subprocess
import sys
import time

MESSAGE = "Remove the installation USB medium,\nthen press any key to restart."

LIBC = ctypes.CDLL(None, use_errno=True)
LINUX_REBOOT_CMD_RESTART = 0x01234567


def input_pressed(data):
    """Linux input_event records: ignore pointer motion and key releases."""
    event = struct.Struct('llHHi')
    return any(kind == 1 and value == 1
               for _sec, _usec, kind, _code, value in event.iter_unpack(data))


def resident_restart_guard(control, ready):
    """Keep a small input/reboot process in RAM, independent of Xorg.

    Importing GTK does not make the live medium safe to remove: the dynamic
    loader can still page in code, and Xorg can die on the first input event.
    Fork before importing GTK, open input devices, and lock these mappings.
    """
    inputs = []
    for name in os.listdir('/dev/input'):
        if name.startswith('event'):
            inputs.append(os.open('/dev/input/' + name, os.O_RDONLY | os.O_NONBLOCK))
    if not inputs:
        raise RuntimeError('No restart input devices')
    poller = select.poll()
    for fd in [control, *inputs]:
        poller.register(fd, select.POLLIN)
    # Resolve the libc symbol while the medium is still present.
    restart = LIBC.reboot
    restart.argtypes = [ctypes.c_int]
    restart.restype = ctypes.c_int
    emergency = os.open('/proc/sysrq-trigger', os.O_WRONLY)
    resource.setrlimit(resource.RLIMIT_MEMLOCK, (resource.RLIM_INFINITY, resource.RLIM_INFINITY))
    if LIBC.mlockall(1 | 2) != 0:  # MCL_CURRENT | MCL_FUTURE
        raise OSError(ctypes.get_errno(), 'Cannot keep restart guard in RAM')
    os.write(ready, b'1')
    os.close(ready)
    armed = False
    while True:
        for fd, flags in poller.poll():
            if fd == control:
                command = os.read(fd, 16)
                if b'r' in command or not command:
                    os.sync()
                    restart(LINUX_REBOOT_CMD_RESTART)
                    os.write(emergency, b'b')
                    return
                if b'a' in command:
                    # Discard input from the original Finish click.
                    for device in inputs:
                        try:
                            while os.read(device, 4096):
                                pass
                        except BlockingIOError:
                            pass
                    armed = True
            elif flags & select.POLLIN:
                try:
                    data = os.read(fd, struct.calcsize('llHHi') * 64)
                except BlockingIOError:
                    continue
                if armed and input_pressed(data):
                    os.sync()
                    restart(LINUX_REBOOT_CMD_RESTART)
                    os.write(emergency, b'b')
                    return
            else:
                poller.unregister(fd)


def start_restart_guard():
    control_read, control_write = os.pipe()
    ready_read, ready_write = os.pipe()
    child = os.fork()
    if child == 0:
        os.close(control_write)
        os.close(ready_read)
        try:
            resident_restart_guard(control_read, ready_write)
        finally:
            os._exit(1)
    os.close(control_read)
    os.close(ready_write)
    readable, _, _ = select.select([ready_read], [], [], 10)
    ready = os.read(ready_read, 1) if readable else b''
    os.close(ready_read)
    if ready != b'1':
        os.close(control_write)
        signal_all([child], signal.SIGKILL)
        os.waitpid(child, 0)
        raise RuntimeError('Restart guard unavailable; rebooting before medium removal')
    return control_write


def reboot():
    os.sync()
    # The reboot system call shuts devices down before restarting. The sysrq
    # emergency restart skips that, and on some laptops the firmware then
    # finds no boot disk until the machine is power-cycled. Neither needs any
    # file from the removed medium.
    LIBC.reboot(LINUX_REBOOT_CMD_RESTART)
    try:
        with open("/proc/sysrq-trigger", "w") as trigger:
            trigger.write("b")
    except OSError:
        pass
    for command in (["/sbin/reboot", "-f"], ["reboot", "-f"]):
        try:
            subprocess.run(command, check=False, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass


def list_processes():
    """Return (pid, parent pid, real uid, name) for every process."""
    processes = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/status", encoding="utf-8") as status:
                fields = dict(line.split(":", 1) for line in status if ":" in line)
            processes.append((int(entry), int(fields["PPid"]),
                              int(fields["Uid"].split()[0]), fields["Name"].strip()))
        except (OSError, KeyError, ValueError):
            continue
    return processes


def desktop_targets(processes, own_pid):
    """Choose what to stop and what to kill to close the live desktop.

    Every live-session process belongs to the session's user, while Xorg,
    Calamares and this helper run as root. mate-session is only stopped:
    killing it would end the session, and LightDM would then replace the X
    server this prompt needs. A fixed list of names would miss helpers that
    respawn their children, such as spaced-window-manager restarting Compiz.
    """
    parents = {pid: ppid for pid, ppid, _uid, _name in processes}
    keep, pid = set(), own_pid
    while pid in parents and pid not in keep:
        keep.add(pid)
        pid = parents[pid]
    sessions = [pid for pid, _ppid, uid, name in processes
                if name == "mate-session" and uid != 0]
    owners = {uid for pid, _ppid, uid, _name in processes if pid in sessions}
    victims = [pid for pid, _ppid, uid, _name in processes
               if uid in owners and pid not in keep and pid not in sessions]
    return sessions, victims


def signal_all(pids, signum):
    for pid in pids:
        try:
            os.kill(pid, signum)
        except OSError:
            pass


def close_live_desktop():
    sessions, victims = desktop_targets(list_processes(), os.getpid())
    signal_all(sessions, signal.SIGSTOP)
    signal_all(victims, signal.SIGTERM)
    time.sleep(1)
    _sessions, victims = desktop_targets(list_processes(), os.getpid())
    signal_all(victims, signal.SIGKILL)


def show_prompt(on_restart, on_ready=None):
    # The session bus died with the desktop; do not wait on accessibility.
    os.environ["NO_AT_BRIDGE"] = "1"
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    provider = Gtk.CssProvider()
    provider.load_from_data(
        b"window { background-color: black; } "
        b"label { color: white; font-size: 28px; } "
        b"button { background-image: none; background-color: #2e2e2e; "
        b"border: 1px solid #a0a0a0; border-radius: 6px; padding: 12px 32px; } "
        b"button:hover { background-color: #444444; } "
        b"button label { color: white; font-size: 20px; }"
    )
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def restart(*_args):
        on_restart()
        return True

    # With no window manager left, fullscreen requests are ignored and new
    # windows get no focus. Popup windows sized to each monitor and an
    # explicit seat grab work without one.
    display = Gdk.Display.get_default()
    windows = []
    for index in range(display.get_n_monitors()):
        geometry = display.get_monitor(index).get_geometry()
        window = Gtk.Window(type=Gtk.WindowType.POPUP)
        window.move(geometry.x, geometry.y)
        window.set_default_size(geometry.width, geometry.height)
        window.add_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
        window.connect("key-press-event", restart)
        window.connect("button-press-event", restart)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=32)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)
        label = Gtk.Label(label=MESSAGE)
        label.set_justify(Gtk.Justification.CENTER)
        box.pack_start(label, False, False, 0)
        button = Gtk.Button(label="Restart now")
        button.set_halign(Gtk.Align.CENTER)
        button.connect("clicked", restart)
        box.pack_start(button, False, False, 0)
        window.add(box)
        window.show_all()
        windows.append(window)

    def grab():
        gdk_window = windows[0].get_window()
        gdk_window.focus(Gdk.CURRENT_TIME)
        status = display.get_default_seat().grab(
            gdk_window, Gdk.SeatCapabilities.ALL, True, None, None, None)
        if status == Gdk.GrabStatus.SUCCESS and on_ready:
            on_ready()
        return status != Gdk.GrabStatus.SUCCESS

    GLib.timeout_add(200, grab)
    Gtk.main()


def main():
    try:
        guard = start_restart_guard()
        close_live_desktop()
        show_prompt(lambda: os.write(guard, b'r'), lambda: os.write(guard, b'a'))
    except Exception as error:  # Any failure must still restart the machine.
        print(f"spaced-reboot-after-install: {error}", file=sys.stderr)
    reboot()


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    main()

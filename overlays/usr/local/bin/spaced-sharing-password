#!/bin/bash
# Set the password Windows PCs use to open this user's shared folders
# (issue #297). Windows 10/11 refuse guest access to shares.
set -uo pipefail
HELPER=/usr/lib/spaced-linux/spaced-samba-password-helper
TITLE="Windows Sharing Password"
user=$(id -un)
if ! command -v smbpasswd >/dev/null; then
    zenity --error --title="$TITLE" --text="Samba is not installed, so this computer cannot share folders."
    exit 1
fi
separator=$'\x1f'
while :; do
    answer=$(zenity --forms --title="$TITLE" --separator="$separator" \
        --text="Windows PCs open the folders you share by signing in as <b>$user</b> with this password. It can differ from your login password." \
        --add-password="Password" --add-password="Confirm password") || exit 0
    first=${answer%%"$separator"*}
    second=${answer#*"$separator"}
    if [ -z "$first" ]; then
        zenity --warning --title="$TITLE" --text="Enter a password."
    elif [ "$first" != "$second" ]; then
        zenity --warning --title="$TITLE" --text="The passwords do not match."
    else
        break
    fi
done
if ! printf '%s\n' "$first" | pkexec "$HELPER"; then
    zenity --error --title="$TITLE" --text="The sharing password was not changed."
    exit 1
fi
addresses=
for address in $(hostname -I 2>/dev/null); do
    case $address in *:*) ;; *) addresses="$addresses \\\\$address" ;; esac
done
[ -n "$addresses" ] || addresses=" this computer's address"
zenity --info --title="$TITLE" --no-markup --text="Windows can now open your shared folders.

In Windows File Explorer, type$addresses in the address bar, then sign in with:
User name: $user
Password: the one you just set"

#!/bin/sh
# Without systemd user-slice cleanup, GTK greeter accessibility helpers can
# survive the greeter and keep advertising lightdm's private AT-SPI socket.
# Stop those helpers after the greeter exits and before the user Xsession runs.
pkill -TERM -u lightdm -x at-spi2-registryd 2>/dev/null || true
pkill -TERM -u lightdm -f '^/usr/libexec/at-spi-bus-launcher' 2>/dev/null || true
pkill -TERM -u lightdm -f '^/usr/bin/dbus-daemon .*at-spi2/accessibility\.conf' 2>/dev/null || true
pkill -TERM -u lightdm -x dbus-launch 2>/dev/null || true
pkill -TERM -u lightdm -f '^/usr/bin/dbus-daemon .*--session' 2>/dev/null || true

exit 0

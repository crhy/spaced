#!/bin/sh
set -eu

STATE_DIR=/var/lib/spaced-linux/first-boot-snapshot
LOG_FILE=/var/log/spaced-first-boot-snapshot.log
CONFIG=/etc/default/spaced-first-boot-snapshot
MAX_ATTEMPTS=3

ENABLED=1
MIN_HEADROOM_MIB=1024
# shellcheck source=/dev/null
[ ! -r "$CONFIG" ] || . "$CONFIG"
[ "$ENABLED" = 1 ] || exit 0

# Never snapshot the disposable live environment. Calamares removes the live
# sudo policy from the installed target, giving us a second conservative test.
if [ -e /run/live/medium ] || [ -e /etc/sudoers.d/spaced-live ]; then
    exit 0
fi

mkdir -p "$STATE_DIR"
[ -e "$STATE_DIR/pending" ] || exit 0
[ ! -e "$STATE_DIR/complete" ] || exit 0

if ! mkdir "$STATE_DIR/lock" 2>/dev/null; then
    exit 0
fi
trap 'rmdir "$STATE_DIR/lock" 2>/dev/null || true' EXIT HUP INT TERM

attempts=0
[ ! -r "$STATE_DIR/attempts" ] || read -r attempts < "$STATE_DIR/attempts"
case "$attempts" in *[!0-9]*|'') attempts=0 ;; esac
[ "$attempts" -lt "$MAX_ATTEMPTS" ] || exit 0
attempts=$((attempts + 1))
printf '%s\n' "$attempts" > "$STATE_DIR/attempts"

exec >> "$LOG_FILE" 2>&1
printf '\n[%s] Fresh-install snapshot attempt %s/%s\n' "$(date -u +%FT%TZ)" "$attempts" "$MAX_ATTEMPTS"

if ! command -v timeshift >/dev/null 2>&1; then
    echo "Timeshift is unavailable"
    exit 1
fi

# Let first-login migrations, package configuration, and network startup settle.
sleep 120

root_device=$(findmnt -n -o SOURCE / | sed 's/\[.*\]$//')
if [ -z "$root_device" ] || [ ! -b "$root_device" ]; then
    echo "Cannot resolve the root block device: $root_device"
    exit 1
fi

df_values=$(df -Pk / | awk 'NR == 2 {print $3 " " $4}')
used_kib=${df_values%% *}
available_kib=${df_values#* }
case "$used_kib" in ''|*[!0-9]*) used_kib=0 ;; esac
case "$available_kib" in ''|*[!0-9]*) available_kib=0 ;; esac
required_kib=$((used_kib + MIN_HEADROOM_MIB * 1024))
if [ "$available_kib" -lt "$required_kib" ]; then
    echo "Not enough free space: ${available_kib} KiB available; ${required_kib} KiB required"
    exit 1
fi

if timeout --signal=TERM --kill-after=30 7200 \
    timeshift --create --comments "Fresh install" --tags O \
    --snapshot-device "$root_device" --rsync --yes --scripted --quiet
then
    date -u +%FT%TZ > "$STATE_DIR/complete"
    rm -f "$STATE_DIR/pending"
    echo "Fresh-install snapshot completed"
else
    status=$?
    echo "Timeshift failed with status $status"
    exit "$status"
fi

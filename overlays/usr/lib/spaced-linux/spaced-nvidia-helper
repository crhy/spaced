#!/bin/bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive

STATE_DIR=/var/lib/spaced-nvidia-installer
RUNS_DIR="$STATE_DIR/runs"
CURRENT_RUN_FILE="$STATE_DIR/current-run"
PENDING_FILE="$STATE_DIR/reboot-required"
RECOVERED_FILE="$STATE_DIR/recovery-reboot-required"
LOG_FILE=/var/log/spaced-nvidia-installer.log
KERNEL="$(uname -r)"
ARCH="$(dpkg --print-architecture)"
DEBIAN_VERSION=""
CUDA_KEYRING_URL=""
MODE=""
DESKTOP_USER=""
REBOOT_AFTER=0
RUN_DIR=""
TRANSACTION_ACTIVE=0
TMP_KEYRING=""

status() {
    printf 'SPACED_STATUS:%s\n' "$*"
    printf '\n==> %s\n' "$*"
}

warning() {
    printf 'SPACED_WARNING:%s\n' "$*"
    printf '\nWARNING: %s\n' "$*" >&2
}

fatal() {
    local code="$1"
    shift
    printf 'SPACED_ERROR:%s:%s\n' "$code" "$*"
    printf '\nERROR: %s\n' "$*" >&2
    if [ "$TRANSACTION_ACTIVE" -eq 1 ]; then
        trap - ERR
        rollback_transaction "$code" || true
    fi
    exit "$code"
}

cleanup() {
    [ -z "$TMP_KEYRING" ] || rm -f "$TMP_KEYRING"
}
trap cleanup EXIT

unexpected_failure() {
    local code="$1" line="$2"
    trap - ERR
    printf 'SPACED_ERROR:30:Unexpected failure near helper line %s.\n' "$line"
    printf '\nERROR: Unexpected failure near helper line %s.\n' "$line" >&2
    if [ "$TRANSACTION_ACTIVE" -eq 1 ]; then
        rollback_transaction "$code" || true
    fi
    exit 30
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --audit|--install|--install-amd|--reboot|--rollback)
                MODE="$1"
                ;;
            --desktop-user)
                shift
                [ "$#" -gt 0 ] || { echo "Missing value for --desktop-user" >&2; return 64; }
                DESKTOP_USER="$1"
                ;;
            --reboot-after)
                REBOOT_AFTER=1
                ;;
            *)
                echo "Unknown argument: $1" >&2
                return 64
                ;;
        esac
        shift
    done
    [ -n "$MODE" ] || { echo "No mode supplied" >&2; return 64; }
}

require_root() {
    [ "$(id -u)" -eq 0 ] || fatal 3 "Administrator authentication is required."
}

resolve_desktop_user() {
    if [ -z "$DESKTOP_USER" ] && [ -n "${PKEXEC_UID:-}" ]; then
        DESKTOP_USER="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
    fi
    if [ -z "$DESKTOP_USER" ]; then
        DESKTOP_USER="$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1; exit}' /etc/passwd)"
    fi
    [ -n "$DESKTOP_USER" ] || fatal 13 "No desktop user account could be identified."
    getent passwd "$DESKTOP_USER" >/dev/null || fatal 13 "Desktop user '$DESKTOP_USER' does not exist."
    local desktop_uid
    desktop_uid="$(id -u "$DESKTOP_USER")"
    [ "$desktop_uid" -ge 1000 ] && [ "$desktop_uid" -lt 60000 ] || fatal 13 "Account '$DESKTOP_USER' is not a normal desktop user."
}

run_as_desktop_user() {
    local home uid
    home="$(getent passwd "$DESKTOP_USER" | cut -d: -f6)"
    uid="$(id -u "$DESKTOP_USER")"
    runuser -u "$DESKTOP_USER" -- env HOME="$home" USER="$DESKTOP_USER" LOGNAME="$DESKTOP_USER" XDG_RUNTIME_DIR="/run/user/$uid" "$@"
}

detect_nvidia_gpu() {
    lspci -nn 2>/dev/null | awk 'tolower($0) ~ /(vga compatible controller|3d controller|display controller)/ && tolower($0) ~ /(nvidia|\[10de:)/ {print; exit}'
}

apt_candidate() {
    apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2; exit}'
}

detect_debian_release() {
    local version_file debian_id debian_codename
    if [ -f /etc/os-release ]; then
        debian_id="$(awk -F= '/^ID=/{gsub(/"/,"",$2); print $2}' /etc/os-release)"
        debian_codename="$(awk -F= '/^VERSION_CODENAME=/{gsub(/"/,"",$2); print $2}' /etc/os-release)"
    fi
    version_file="$(cat /etc/debian_version 2>/dev/null || true)"
    case "${version_file%%/*}" in
        trixie)
            DEBIAN_VERSION=13
            ;;
        forky)
            DEBIAN_VERSION=13
            ;;
        bookworm)
            DEBIAN_VERSION=12
            ;;
        bullseye)
            DEBIAN_VERSION=11
            ;;
        *)
            if printf '%s\n' "$version_file" | grep -Eq '^[0-9]+\.[0-9]+'; then
                DEBIAN_VERSION="${version_file%%.*}"
            elif [ "$debian_codename" = "ceres" ] || [ "$debian_id" = "devuan" ]; then
                DEBIAN_VERSION=13
            else
                DEBIAN_VERSION=13
            fi
            ;;
    esac
    CUDA_KEYRING_URL="https://developer.download.nvidia.com/compute/cuda/repos/debian${DEBIAN_VERSION}/x86_64/cuda-keyring_1.1-1_all.deb"
    printf 'Detected Debian compatibility version: %s\n' "$DEBIAN_VERSION"
}

require_candidate() {
    local package="$1" code="$2" candidate
    candidate="$(apt_candidate "$package")"
    if [ -z "$candidate" ] || [ "$candidate" = "(none)" ]; then
        fatal "$code" "Required package '$package' is unavailable from the configured repositories."
    fi
    printf 'Available: %-42s %s\n' "$package" "$candidate"
}

check_disk_space() {
    local root_kb boot_kb
    root_kb="$(df -Pk / | awk 'NR==2 {print $4}')"
    boot_kb="$(df -Pk /boot | awk 'NR==2 {print $4}')"
    [ "${root_kb:-0}" -ge 2097152 ] || fatal 14 "At least 2 GB of free space is required on the root filesystem."
    [ "${boot_kb:-0}" -ge 204800 ] || fatal 15 "At least 200 MB of free space is required on the filesystem containing /boot."
    printf 'Root free: %s MB\n' "$((root_kb / 1024))"
    printf '/boot free: %s MB\n' "$((boot_kb / 1024))"
}

installed_packages() {
    dpkg-query -W -f='${db:Status-Abbrev}\t${binary:Package}\n' 2>/dev/null | awk '$1 ~ /^ii/ {print $2}' | sort -u
}

installed_driver_versions() {
    dpkg-query -W -f='${db:Status-Abbrev}\t${binary:Package}\t${Version}\n' 2>/dev/null |
        awk '$1 ~ /^ii/ && $2 ~ /^(cuda-|nvidia-|libnvidia-|libcuda|libnvcuvid|xserver-xorg-video-nvidia|firmware-nvidia-gsp|glx-alternative-nvidia|libglx-nvidia|libegl-nvidia|libgl1-nvidia)/ {print $2 "=" $3}' | sort -u
}

new_run() {
    local run_id
    run_id="$(date +%Y%m%d-%H%M%S)"
    RUN_DIR="$(mktemp -d "$RUNS_DIR/$run_id-XXXXXXXX")"
}

backup_configuration() {
    status "Backing up current graphics configuration"
    python3 /usr/lib/spaced-linux/spaced-nvidia-config.py backup "$RUN_DIR/configuration.json"
    installed_packages > "$RUN_DIR/packages-before.txt"
    installed_driver_versions > "$RUN_DIR/driver-versions-before.txt"
    printf '%s\n' "$RUN_DIR" > "$CURRENT_RUN_FILE"
    chmod 0644 "$CURRENT_RUN_FILE"
}

record_configuration_changes() {
    python3 /usr/lib/spaced-linux/spaced-nvidia-config.py capture "$RUN_DIR/configuration.json"
}

restore_configuration() {
    [ -n "$RUN_DIR" ] && [ -f "$RUN_DIR/configuration.json" ] || {
        warning "This transaction has no safe per-file configuration backup; manual recovery is required."
        return 52
    }
    python3 /usr/lib/spaced-linux/spaced-nvidia-config.py restore "$RUN_DIR/configuration.json"
}

record_new_nvidia_packages() {
    installed_packages > "$RUN_DIR/packages-after.txt" || return $?
    comm -13 "$RUN_DIR/packages-before.txt" "$RUN_DIR/packages-after.txt" > "$RUN_DIR/new-packages.txt" || return $?
    grep -E '^(cuda-|nvidia-|libnvidia-|libcuda|libnvcuvid|xserver-xorg-video-nvidia|firmware-nvidia-gsp|glx-alternative-nvidia|nvidia-alternative|libglx-nvidia|libegl-nvidia|libgl1-nvidia)' \
        "$RUN_DIR/new-packages.txt" > "$RUN_DIR/new-nvidia-packages.txt" || [ "$?" -eq 1 ]
}

rollback_step() {
    local description="$1"
    shift
    if "$@"; then
        return 0
    fi
    warning "Recovery step failed: $description. Review the log before rebooting."
    return 1
}

rollback_transaction() {
    local original_code="${1:-30}" failed=0 was_active="$TRANSACTION_ACTIVE"
    local packages_to_remove=()
    TRANSACTION_ACTIVE=0
    if [ -z "$RUN_DIR" ] && [ -f "$CURRENT_RUN_FILE" ]; then
        RUN_DIR="$(cat "$CURRENT_RUN_FILE")"
    fi
    status "Recovering graphics packages and saved configuration"
    printf 'Original operation status: %s\n' "$original_code"
    rollback_step "clear previous recovery verification" rm -f "$RECOVERED_FILE" || failed=1
    # On an interrupted install, capture its partial result before restoring it.
    if [ "$was_active" -eq 1 ]; then
        rollback_step "record partial configuration changes" record_configuration_changes || failed=1
    fi
    rollback_step "complete pending package configuration" dpkg --configure -a || failed=1
    rollback_step "repair package dependencies" apt-get -o DPkg::Lock::Timeout=120 -f install -y || failed=1
    if [ -n "$RUN_DIR" ] && [ -f "$RUN_DIR/packages-before.txt" ]; then
        if rollback_step "identify new driver packages" record_new_nvidia_packages; then
            mapfile -t packages_to_remove < "$RUN_DIR/new-nvidia-packages.txt"
            if [ "${#packages_to_remove[@]}" -gt 0 ]; then
                rollback_step "remove new NVIDIA packages" apt-get -o DPkg::Lock::Timeout=120 purge -y "${packages_to_remove[@]}" || failed=1
            fi
        else
            failed=1
        fi
        if [ -f "$RUN_DIR/driver-versions-before.txt" ]; then
            local previous_versions=()
            mapfile -t previous_versions < "$RUN_DIR/driver-versions-before.txt"
            if [ "${#previous_versions[@]}" -gt 0 ]; then
                rollback_step "restore previous NVIDIA package versions" apt-get -o DPkg::Lock::Timeout=120 --no-remove --allow-downgrades install -y "${previous_versions[@]}" || failed=1
            fi
        else
            warning "Previous driver package versions were not recorded; recovery cannot be verified."
            failed=1
        fi
        rollback_step "restore graphics configuration" restore_configuration || failed=1
    else
        warning "The saved package list is missing; automatic recovery cannot safely remove driver packages."
        failed=1
    fi
    rollback_step "refresh package information" apt-get -o APT::Update::Error-Mode=any -o Acquire::Retries=3 update || failed=1
    rollback_step "restore Nouveau and Mesa packages" apt-get -o DPkg::Lock::Timeout=120 --no-remove install -y --reinstall firmware-nvidia-graphics xserver-xorg-video-nouveau libgl1-mesa-dri libglx-mesa0 || failed=1
    if command -v update-glx >/dev/null 2>&1; then
        rollback_step "restore GLX alternatives" update-glx --auto glx || failed=1
    fi
    rollback_step "refresh desktop defaults" dconf update || failed=1
    rollback_step "rebuild boot images" update-initramfs -u -k all || failed=1
    rollback_step "rebuild GRUB configuration" update-grub || failed=1
    # A failed recovery must never leave a marker authorizing the verified-driver reboot path.
    rollback_step "clear installation verification" rm -f "$PENDING_FILE" || failed=1
    if [ "$failed" -eq 0 ]; then
        rollback_step "record completed recovery" touch "$RECOVERED_FILE" || failed=1
    fi
    if [ "$failed" -ne 0 ]; then
        printf 'SPACED_ERROR:52:Graphics recovery is incomplete. Review the log and repair the failed steps before rebooting.\n'
        return 52
    fi
    status "Saved graphics configuration restored; reboot to activate it"
    printf 'SPACED_SUCCESS:restored:%s\n' "$KERNEL"
    if [ "$REBOOT_AFTER" -eq 1 ]; then
        sync
        /sbin/reboot
    fi
    return 0
}

check_secure_boot() {
    local state
    state="$(mokutil --sb-state 2>&1 || true)"
    printf '%s\n' "$state"
    if grep -qi 'SecureBoot enabled' <<<"$state"; then
        fatal 10 "Secure Boot is enabled. Disable Secure Boot in firmware, boot Spaced Linux again, and rerun the installer. No graphics-driver changes were made."
    fi
}

install_prerequisites() {
    local packages=(
        "linux-headers-$KERNEL"
        linux-headers-amd64
        build-essential
        dkms
        ca-certificates
        curl
        mokutil
        pciutils
        initramfs-tools
        mesa-utils
        x11-utils
        wmctrl
        dconf-cli
        compiz
        compiz-mate
    )
    status "Checking required Devuan packages"
    for package in "${packages[@]}"; do
        if [ "$package" = "linux-headers-$KERNEL" ]; then
            require_candidate "$package" 20
        else
            require_candidate "$package" 21
        fi
    done
    status "Installing exact kernel headers and graphics prerequisites"
    apt-get install -y "${packages[@]}" || fatal 21 "One or more required Devuan packages could not be installed."
    [ -e "/lib/modules/$KERNEL/build/Makefile" ] || fatal 20 "The exact kernel headers were installed, but /lib/modules/$KERNEL/build is unavailable."
}

install_official_repository() {
    detect_debian_release
    status "Enabling NVIDIA's official Debian $DEBIAN_VERSION repository"
    TMP_KEYRING="$(mktemp --suffix=.deb)"
    curl --fail --location --show-error --connect-timeout 20 --retry 3 --output "$TMP_KEYRING" "$CUDA_KEYRING_URL" || fatal 22 "NVIDIA's official repository keyring could not be downloaded."
    [ "$(dpkg-deb -f "$TMP_KEYRING" Package 2>/dev/null)" = "cuda-keyring" ] || fatal 22 "The downloaded NVIDIA repository package failed validation."
    dpkg -i "$TMP_KEYRING" || fatal 22 "NVIDIA's repository keyring could not be installed."
    rm -f "$TMP_KEYRING"
    TMP_KEYRING=""
    apt-get update || fatal 22 "NVIDIA's repository was enabled, but its package index could not be downloaded."
    require_candidate nvidia-driver-assistant 23
    apt-get install -y nvidia-driver-assistant || fatal 23 "NVIDIA Driver Assistant could not be installed."
    local supported_distros
    supported_distros="$(nvidia-driver-assistant --list-supported-distros 2>&1 || true)"
    if ! grep -Eqi "Debian(:|[[:space:]])?${DEBIAN_VERSION}|Debian.*${DEBIAN_VERSION}" <<<"$supported_distros"; then
        fatal 24 "NVIDIA Driver Assistant does not support Debian $DEBIAN_VERSION. Driver installation has stopped."
    fi
    # Query compatibility before making any driver changes. The assistant
    # rejects unsupported legacy GPUs and selects the appropriate branch.
    nvidia-driver-assistant --distro "Debian:$DEBIAN_VERSION" --verbose ||
        fatal 24 "NVIDIA no longer supports this GPU on the available driver branches. Keep Nouveau; the existing desktop has not been disabled."

}

install_driver_packages() {
    status "Selecting and installing the NVIDIA driver"
    nvidia-driver-assistant --distro "Debian:$DEBIAN_VERSION" --install --verbose || fatal 30 "NVIDIA Driver Assistant could not complete the driver installation."
    status "Completing DKMS builds for kernel $KERNEL"
    dkms autoinstall -k "$KERNEL" || warning "DKMS reported an error; module verification will decide whether rollback is required."
    depmod -a "$KERNEL"
    record_new_nvidia_packages
}

verify_modules_on_disk() {
    status "Verifying NVIDIA kernel modules"
    local module
    for module in nvidia nvidia_modeset nvidia_uvm nvidia_drm; do
        modinfo -k "$KERNEL" "$module" >/dev/null 2>&1 || fatal 40 "Required module '$module' was not built for kernel $KERNEL."
        printf 'Verified module: %s\n' "$module"
    done
    dkms status || true
}

neutralize_nvidia_blacklists() {
    status "Removing stale rules that block NVIDIA modules"
    python3 - <<'PY'
from pathlib import Path
import re

root = Path('/etc/modprobe.d')
root.mkdir(parents=True, exist_ok=True)
modules = r'(?:nvidia|nvidia_drm|nvidia_modeset|nvidia_uvm|nvidia_peermem)'
patterns = [
    re.compile(rf'^\s*blacklist\s+{modules}(?:\s|$)', re.I),
    re.compile(rf'^\s*install\s+{modules}(?:\s|$)', re.I),
    re.compile(r'^\s*options\s+nvidia_drm\b.*\bmodeset\s*=\s*0(?:\s|$)', re.I),
]
for path in sorted(root.glob('*')):
    if not path.is_file() or path.is_symlink():
        continue
    try:
        original = path.read_text(encoding='utf-8')
    except UnicodeDecodeError:
        continue
    changed = False
    output = []
    for line in original.splitlines(keepends=True):
        if any(pattern.search(line) for pattern in patterns):
            output.append('# Disabled by Spaced NVIDIA Installer: ' + line)
            changed = True
        else:
            output.append(line)
    if changed:
        path.write_text(''.join(output), encoding='utf-8')
Path('/etc/modprobe.d/spaced-live-nvidia.conf').unlink(missing_ok=True)
PY
}

write_nvidia_policy() {
    status "Disabling Nouveau and enabling NVIDIA DRM modesetting"
    cat > /etc/modprobe.d/zz-spaced-nvidia.conf <<'EOF_POLICY'
# Managed by Spaced NVIDIA Driver Installer.
blacklist nouveau
options nouveau modeset=0
options nvidia_drm modeset=1
EOF_POLICY

    mkdir -p /etc/initramfs-tools
    touch /etc/initramfs-tools/modules
    sed -i -E '/^[[:space:]]*(nouveau|nvidia|nvidia_modeset|nvidia_uvm|nvidia_drm)[[:space:]]*(#.*)?$/d' /etc/initramfs-tools/modules
    cat >> /etc/initramfs-tools/modules <<'EOF_MODULES'
# Managed by Spaced NVIDIA Driver Installer.
nvidia
nvidia_modeset
nvidia_uvm
nvidia_drm
EOF_MODULES
}

sanitize_grub() {
    status "Removing conflicting graphics boot arguments"
    [ -f /etc/default/grub ] || touch /etc/default/grub
    python3 - <<'PY'
from pathlib import Path
import re
import shlex

path = Path('/etc/default/grub')
lines = path.read_text(encoding='utf-8').splitlines()
keys = {'GRUB_CMDLINE_LINUX', 'GRUB_CMDLINE_LINUX_DEFAULT'}
seen = set()
out = []
nvidia_names = {'nvidia', 'nvidia_drm', 'nvidia_modeset', 'nvidia_uvm', 'nvidia_peermem'}

def clean_token(token):
    if token == 'nomodeset':
        return None
    if token.startswith('nouveau.modeset=') or token.startswith('nvidia-drm.modeset='):
        return None
    for prefix in ('module_blacklist=', 'modprobe.blacklist=', 'rd.driver.blacklist='):
        if token.startswith(prefix):
            values = [v for v in token[len(prefix):].split(',') if v and v not in nvidia_names and v != 'nouveau']
            return prefix + ','.join(values) if values else None
    return token

for line in lines:
    match = re.match(r'^(GRUB_CMDLINE_LINUX(?:_DEFAULT)?)=(.*)$', line)
    if not match:
        out.append(line)
        continue
    key, raw = match.groups()
    seen.add(key)
    value = raw.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        value = value[1:-1]
    try:
        words = shlex.split(value)
    except ValueError:
        words = value.split()
    words = [cleaned for word in words if (cleaned := clean_token(word))]
    if key == 'GRUB_CMDLINE_LINUX_DEFAULT':
        for required in ('nvidia-drm.modeset=1', 'modprobe.blacklist=nouveau'):
            if required not in words:
                words.append(required)
    out.append(f'{key}=' + shlex.quote(' '.join(words)))

if 'GRUB_CMDLINE_LINUX' not in seen:
    out.append("GRUB_CMDLINE_LINUX=''")
if 'GRUB_CMDLINE_LINUX_DEFAULT' not in seen:
    out.append("GRUB_CMDLINE_LINUX_DEFAULT='nvidia-drm.modeset=1 modprobe.blacklist=nouveau'")
path.write_text('\n'.join(out) + '\n', encoding='utf-8')
PY
}

remove_stale_xorg_configs() {
    status "Removing stale forced Xorg driver configuration"
    mkdir -p "$RUN_DIR/disabled-xorg"
    if [ -e /etc/X11/xorg.conf ]; then
        mv /etc/X11/xorg.conf "$RUN_DIR/disabled-xorg/xorg.conf"
    fi
    find /etc/X11/xorg.conf.d -maxdepth 1 -type f \( -iname '*nvidia*' -o -iname '*nouveau*' \) -exec mv -t "$RUN_DIR/disabled-xorg" {} + 2>/dev/null || true
}

install_compiz_launcher() {
    status "Verifying the installed Compiz launcher"
    # Keep the maintained session supervisor supplied by desktop updates.
    [ -x /usr/local/bin/spaced-window-manager ] || fatal 46 "Update Spaced Linux to install the supported Compiz session launcher."
    bash -n /usr/local/bin/spaced-window-manager || fatal 46 "The Compiz session launcher is invalid."


}

verify_modprobe_policy() {
    status "Verifying module policy"
    local config line
    config="$(modprobe --showconfig 2>/dev/null || true)"
    if grep -Eqi '^[[:space:]]*(blacklist|install)[[:space:]]+(nvidia|nvidia_drm|nvidia_modeset|nvidia_uvm|nvidia_peermem)([[:space:]]|$)' <<<"$config"; then
        while IFS= read -r line; do
            printf '%s\n' "$line"
        done <<<"$(grep -Ei '^[[:space:]]*(blacklist|install)[[:space:]]+(nvidia|nvidia_drm|nvidia_modeset|nvidia_uvm|nvidia_peermem)([[:space:]]|$)' <<<"$config")"
        fatal 42 "An active modprobe rule still blocks an NVIDIA module."
    fi
    grep -Eqi '^[[:space:]]*blacklist[[:space:]]+nouveau([[:space:]]|$)' <<<"$config" || fatal 43 "Nouveau is not blacklisted in the final module policy."
    modprobe -S "$KERNEL" -n -v nvidia 2>&1 | tee "$RUN_DIR/modprobe-nvidia-dry-run.txt"
    if grep -Eqi '(/bin/false|/bin/true)' "$RUN_DIR/modprobe-nvidia-dry-run.txt"; then
        fatal 42 "The NVIDIA module is redirected by an install rule."
    fi
}

verify_initramfs() {
    status "Rebuilding and inspecting the initramfs"
    update-initramfs -u -k "$KERNEL" || fatal 41 "The initramfs could not be rebuilt."
    local initrd="/boot/initrd.img-$KERNEL" listing module pattern
    [ -s "$initrd" ] || fatal 41 "The rebuilt initramfs is missing or empty."
    listing="$(lsinitramfs "$initrd")" || fatal 41 "The rebuilt initramfs could not be inspected."
    for module in nvidia nvidia-modeset nvidia-uvm nvidia-drm; do
        pattern="/${module}\\.ko([.][A-Za-z0-9]+)?$"
        grep -Eq "$pattern" <<<"$listing" || fatal 44 "The rebuilt initramfs does not contain $module.ko."
        printf 'Initramfs contains: %s.ko\n' "$module"
    done
}

verify_userspace_and_grub() {
    status "Verifying Xorg, GLX, GRUB, and Compiz configuration"
    [ -x /usr/bin/nvidia-smi ] || fatal 45 "nvidia-smi is missing after driver installation."
    [ -f /usr/lib/xorg/modules/drivers/nvidia_drv.so ] || fatal 45 "The NVIDIA Xorg driver is missing."
    local ldd_out
    ldd_out="$(ldd /usr/lib/xorg/modules/drivers/nvidia_drv.so 2>/dev/null || true)"
    grep -q 'not found' <<<"$ldd_out" && fatal 45 "The NVIDIA Xorg driver has an unresolved library dependency."
    [ -x /usr/local/bin/spaced-window-manager ] || fatal 46 "The Compiz launcher is missing or not executable."
    command -v compiz >/dev/null 2>&1 || fatal 46 "Compiz is not installed."
    command -v glxinfo >/dev/null 2>&1 || fatal 46 "glxinfo is not installed."
    grep -Eq 'nvidia-drm\.modeset=1' /etc/default/grub || fatal 47 "GRUB does not enable NVIDIA DRM modesetting."
    grep -Eq 'modprobe\.blacklist=nouveau' /etc/default/grub || fatal 47 "GRUB does not blacklist Nouveau."
    if grep -Eq "(^|[[:space:]\"'])nomodeset($|[[:space:]\"'])" /etc/default/grub; then
        fatal 47 "A nomodeset argument remains in /etc/default/grub."
    fi
    if grep -Eqi "(module_blacklist|modprobe\.blacklist|rd\.driver\.blacklist)=[^\"' ]*nvidia" /etc/default/grub; then
        fatal 47 "A GRUB argument still blacklists NVIDIA."
    fi
    if command -v update-glx >/dev/null 2>&1; then
        update-glx --auto glx || fatal 45 "GLX alternatives could not be configured."
    fi
    update-grub || fatal 47 "GRUB could not be rebuilt; the installation is not verified."
}

write_pending_marker() {
    local gpu="$1"
    cat > "$PENDING_FILE" <<EOF_MARKER
run_dir=$RUN_DIR
kernel=$KERNEL
desktop_user=$DESKTOP_USER
gpu=$gpu
installed_at=$(date --iso-8601=seconds)
EOF_MARKER
    chmod 0644 "$PENDING_FILE"
}

audit_system() {
    /usr/local/bin/spaced-graphics-report
}

install_amd() {
    require_root
    lspci -nn | grep -E '(VGA|3D|Display) controller|VGA compatible controller' | grep -qiE 'AMD|ATI|\[1002:' || fatal 12 "No AMD graphics device was detected."
    [ -s /etc/X11/xorg.conf.d/20-spaced-amdgpu.conf ] || fatal 21 "Update Spaced Linux to install the AMD TearFree configuration."
    status "Refreshing verified Devuan graphics packages"
    apt-get -o APT::Update::Error-Mode=any -o Acquire::Retries=3 update || fatal 16 "Package information could not be downloaded."
    apt-get -o DPkg::Lock::Timeout=120 --no-remove install -y \
        firmware-amd-graphics xserver-xorg-video-amdgpu libgl1-mesa-dri mesa-vulkan-drivers amdgpu-top || fatal 21 "AMD graphics packages could not be updated."
    update-initramfs -u -k all || fatal 41 "AMD packages were updated, but the boot images could not be refreshed. Review the log and retry before rebooting."
    printf 'SPACED_SUCCESS:amd:%s\n' "$KERNEL"
}

install_system() {
    require_root
    resolve_desktop_user
    local gpu
    new_run
    exec > >(tee -a "$LOG_FILE" "$RUN_DIR/install.log") 2>&1
    status "Detecting NVIDIA hardware"
    gpu="$(detect_nvidia_gpu || true)"
    [ -n "$gpu" ] || fatal 12 "No NVIDIA graphics device was detected."
    printf '%s\n' "$gpu"
    [ "$ARCH" = amd64 ] || fatal 11 "This installer currently supports amd64 only. Detected: $ARCH."
    check_disk_space
    status "Refreshing Devuan package information"
    apt-get -o APT::Update::Error-Mode=any -o Acquire::Retries=3 update || fatal 16 "Package information could not be downloaded."
    install_prerequisites
    check_secure_boot
    backup_configuration
    rm -f "$RECOVERED_FILE"
    TRANSACTION_ACTIVE=1
    trap 'unexpected_failure $? $LINENO' ERR
    install_official_repository
    install_driver_packages
    verify_modules_on_disk
    neutralize_nvidia_blacklists
    write_nvidia_policy
    sanitize_grub
    remove_stale_xorg_configs
    install_compiz_launcher
    verify_modprobe_policy
    verify_initramfs
    verify_userspace_and_grub
    record_configuration_changes
    write_pending_marker "$gpu"
    TRANSACTION_ACTIVE=0
    trap - ERR
    status "NVIDIA driver and Compiz configuration verified"
    printf 'SPACED_SUCCESS:installed:%s\n' "$KERNEL"
    echo "A reboot is required. Spaced Linux will verify NVIDIA, GLX, and Compiz after login."
}

reboot_system() {
    require_root
    [ -f "$PENDING_FILE" ] || [ -f "$RECOVERED_FILE" ] || fatal 50 "No verified graphics installation or completed recovery is awaiting reboot."
    status "Rebooting into the verified graphics configuration"
    sync
    /sbin/reboot
}

rollback_system() {
    require_root
    [ -f "$CURRENT_RUN_FILE" ] || fatal 51 "No Spaced NVIDIA transaction is available to roll back."
    RUN_DIR="$(cat "$CURRENT_RUN_FILE")"
    rollback_transaction 51
}

main() {
    parse_args "$@" || return $?
    if [ "$MODE" = --audit ]; then
        audit_system
        return
    fi
    require_root
    install -d -m 0755 "$RUNS_DIR"
    exec 9>"$STATE_DIR/transaction.lock"
    flock -n 9 || fatal 17 "Another graphics operation is already running."
    touch "$LOG_FILE"
    chmod 0644 "$LOG_FILE"
    case "$MODE" in
        --install) install_system ;;
        --install-amd) install_amd ;;
        --reboot) reboot_system ;;
        --rollback) rollback_system ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi

#!/usr/bin/python3
"""Give every detected GPU a role (issue #426).

The desktop seat is driven by the integrated GPU, and the discrete GPU is
left free for AI and games. This is the decision slice only: it enumerates
display controllers, chooses the desktop and free GPU, and writes an X
config snippet. Applying or displaying the roles lives in a later slice.
Nothing here installs or removes drivers, and the tool never writes a
service unit or service-manager command: Spaced Linux is sysvinit-only.
"""
import argparse
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

DEFAULT_OUT = "/etc/X11/xorg.conf.d/20-spaced-gpu-roles.conf"

VENDOR_INTEL = 0x8086
VENDOR_NVIDIA = 0x10de
VENDOR_AMD = 0x1002

# PCI base class 03 covers VGA (0300), XGA (0301), 3D controller (0302) and
# other display controllers (0380); audio (04xx) and bridges (06xx) do not.
DISPLAY_CLASS = re.compile(r"^03")

SLOT = re.compile(r"^((?:[0-9a-f]{4}:)?([0-9a-f]{2})):([0-9a-f]{2})\.([0-9a-f])\s+(.*)$")
CLASS_ID = re.compile(r"\[([0-9a-f]{4})\]")
DEVICE_ID = re.compile(r"\[([0-9a-f]{4}):([0-9a-f]{4})\]")


@dataclass
class Gpu:
    slot: str
    bus: str
    device: str
    function: str
    class_code: str
    vendor: int
    device_id: int
    description: str

    @property
    def bus_id(self):
        return f"PCI:{int(self.bus, 16)}:{int(self.device, 16)}:{int(self.function, 16)}"


def parse_lspci(text):
    """Every display controller in 'lspci -nn' output, ignoring audio and bridges."""
    gpus = []
    for line in text.splitlines():
        slot = SLOT.match(line)
        if not slot:
            continue
        klass = CLASS_ID.search(slot.group(5))
        ids = DEVICE_ID.search(slot.group(5))
        if not klass or not ids:
            continue
        if not DISPLAY_CLASS.match(klass.group(1)):
            continue
        gpus.append(Gpu(
            slot=slot.group(0).split(maxsplit=1)[0],
            bus=slot.group(2), device=slot.group(3), function=slot.group(4),
            class_code=klass.group(1),
            vendor=int(ids.group(1), 16), device_id=int(ids.group(2), 16),
            description=slot.group(5),
        ))
    return gpus


def is_integrated(gpu):
    if gpu.vendor == VENDOR_INTEL:
        return True
    if gpu.vendor == VENDOR_NVIDIA:
        return False
    if gpu.vendor == VENDOR_AMD:
        # An AMD APU's graphics attaches to the processor's host bus and
        # enumerates on bus 00; a discrete card sits behind a PCIe root port
        # on a higher bus. (AM5 APUs live on a higher-numbered NBIO bus;
        # handling that is part of the later applying slice.)
        return gpu.bus == "00"
    return False


def choose_roles(devices):
    """(desktop_gpu, free_gpu): the iGPU drives the desktop, the dGPU stays free."""
    integrated = [d for d in devices if is_integrated(d)]
    discrete = [d for d in devices if not is_integrated(d)]
    if integrated and discrete:
        return integrated[0], discrete[0]
    if devices:
        return devices[0], None
    return None, None


def x_config(desktop, free):
    return "\n".join([
        "# Generated by /usr/lib/spaced-linux/spaced-gpu-roles (issue #426).",
        "# The integrated GPU drives the desktop seat; delete this file and",
        "# restart the display to return to X's default probing.",
        "",
        'Section "ServerLayout"',
        '    Identifier "spaced-gpu-roles"',
        '    Screen     "spaced-desktop"',
        f'    Comment    "Discrete GPU {free.slot} ({free.description.strip()}) is off-limits for the desktop seat; it stays free for AI and games"',
        "EndSection",
        "",
        'Section "Screen"',
        '    Identifier "spaced-desktop"',
        '    Device     "spaced-desktop-gpu"',
        "EndSection",
        "",
        'Section "Device"',
        '    Identifier "spaced-desktop-gpu"',
        f'    BusID      "{desktop.bus_id}"',
        '    Option     "PrimaryDevice" "true"',
        "EndSection",
        "",
    ])


def write_config(path, desktop, free):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(x_config(desktop, free))


def read_lspci(path):
    if path:
        return Path(path).read_text()
    result = subprocess.run(["lspci", "-nn"], check=False, capture_output=True, text=True, errors="replace")
    if result.returncode != 0:
        raise SystemExit(f"spaced-gpu-roles: lspci -nn failed: {result.stderr.strip()}")
    return result.stdout


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="spaced-gpu-roles",
        description="Drive the desktop on the integrated GPU and leave the discrete GPU free for AI and games.")
    parser.add_argument("--lspci", metavar="PATH", help="read 'lspci -nn' output from PATH instead of running lspci")
    parser.add_argument("--out", metavar="PATH", default=DEFAULT_OUT,
                        help="X config snippet to write when both GPU roles exist (default: %(default)s)")
    args = parser.parse_args(argv)

    devices = parse_lspci(read_lspci(args.lspci))
    if not devices:
        print("spaced-gpu-roles: no display controller was found")
        return 0
    desktop, free = choose_roles(devices)
    print(f"spaced-gpu-roles: desktop GPU {desktop.slot}: {desktop.description.strip()}")
    if free:
        print(f"spaced-gpu-roles: free GPU      {free.slot}: {free.description.strip()}")
    else:
        print("spaced-gpu-roles: only one GPU role exists; nothing is left free")
    if desktop and free:
        write_config(Path(args.out), desktop, free)
        print(f"spaced-gpu-roles: wrote {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

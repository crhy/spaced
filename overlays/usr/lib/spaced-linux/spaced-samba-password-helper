#!/bin/bash
# Give the calling user a Samba password, so Windows 10/11, which refuse
# guest access, can sign in to the folders they share (issue #297).
# The user is the one pkexec authenticated, never an argument; the
# password arrives on standard input and never on a command line.
set -euo pipefail
export LC_ALL=C
[ "$(id -u)" -eq 0 ] || { echo 'Run this through pkexec.' >&2; exit 1; }
[ $# -eq 0 ] || { echo 'This helper accepts no arguments.' >&2; exit 2; }
uid=${PKEXEC_UID:-}
[[ $uid =~ ^[0-9]+$ ]] && [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] \
    || { echo 'Only a desktop user can set a sharing password.' >&2; exit 1; }
user=$(getent passwd "$uid" | cut -d: -f1)
[ -n "$user" ] || { echo "No account has UID $uid." >&2; exit 1; }
IFS= read -r password || true
[ -n "$password" ] || { echo 'The password is empty.' >&2; exit 1; }
printf '%s\n%s\n' "$password" "$password" | smbpasswd -s -a "$user" >/dev/null
smbpasswd -e "$user" >/dev/null

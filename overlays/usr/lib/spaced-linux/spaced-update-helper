#!/bin/bash
# Invoked through pkexec; user Flatpaks must be updated by the calling desktop
# process, never as root (root has a different per-user installation).
set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive LC_ALL=C
step() { printf 'SPACED_STEP:%s:%s\n' "$1" "$2"; }
log() { printf '%s\n' "$*"; }
update_failed() {
  local status=$?
  log "Update stopped (status $status). Review the preceding error and retry; completed package transactions are preserved."
  exit "$status"
}
trap update_failed ERR

# Install session protection BEFORE even configuring a pending old elogind.
# Never replace an administrator's policy or silently continue without safety.
ensure_session_guard() {
  local payload=/usr/lib/spaced-linux/spaced-policy-rc.d
  local policy=/usr/sbin/policy-rc.d owner mode action status
  if [[ ${SPACED_UPDATE_TEST:-} == 1 ]]; then
    payload=${SPACED_UPDATE_TEST_SESSION_PAYLOAD:?test session payload required}
    policy=${SPACED_UPDATE_TEST_SESSION_POLICY:?isolated test policy required}
  fi
  if [[ ! -f $payload || -L $payload || ! -x $payload ]]; then
    log 'Session protection is missing; refusing package changes. Reinstall Spaced Update first.'
    return 1
  fi
  read -r owner mode <<< "$(stat -c '%u %a' "$payload")"
  if [[ ${SPACED_UPDATE_TEST:-} != 1 && $owner != 0 ]] || (( (8#$mode & 8#022) != 0 )); then
    log 'Session protection has unsafe ownership or permissions; refusing package changes.'
    return 1
  fi
  if [[ ! -e $policy && ! -L $policy ]]; then
    # No force: a concurrently installed administrator policy must win.
    ln -s "$payload" "$policy" || return 1
  fi
  [[ $(readlink "$policy" 2>/dev/null || true) == "$payload" ]] && return 0
  if [[ ! -f $policy || ! -x $policy ]]; then
    log 'The existing service policy is unusable; refusing package changes.'
    return 1
  fi
  read -r owner mode <<< "$(stat -Lc '%u %a' "$policy")"
  if [[ ${SPACED_UPDATE_TEST:-} != 1 && $owner != 0 ]] || (( (8#$mode & 8#022) != 0 )); then
    log 'The existing service policy has unsafe ownership or permissions; refusing package changes.'
    return 1
  fi
  # A custom policy remains untouched. Require an explicit denial of every
  # destructive elogind action; fallback/unknown/error results are not safe.
  for action in stop restart try-restart force-reload reload; do
    if "$policy" elogind "$action"; then status=0; else status=$?; fi
    if [[ $status != 101 ]]; then
      log "The existing service policy does not protect elogind ($action). It was left unchanged; refusing package changes."
      return 1
    fi
  done
}

# crhy/spacedupdate#17: the Spaced 8.26.6 GRUB theme pointed its background
# outside the boot-readable theme directory, and no package ever updates
# /etc/default/grub, so installs made from that ISO keep pointing
# GRUB_THEME/GRUB_BACKGROUND at files that are missing or unreadable from the
# boot partition. Repair that setting idempotently: only a *Spaced* path that
# cannot be read is changed, an administrator's own theme is never touched,
# and an already-good configuration is a no-op.
GRUB_THEME_PATH=/boot/grub/themes/spaced/theme.txt

# Echoes the value of an active (uncommented) GRUB_THEME or GRUB_BACKGROUND
# assignment; returns 1 for every other line.
grub_assignment_value() {
  local line=$1 value
  case $line in
    GRUB_THEME=*) value=${line#GRUB_THEME=} ;;
    GRUB_BACKGROUND=*) value=${line#GRUB_BACKGROUND=} ;;
    *) return 1 ;;
  esac
  if [[ $value == \"*\" || $value == \'*\' ]]; then
    value=${value:1:${#value}-2}
  fi
  value=${value%$'\r'}
  [[ -n $value ]] || return 1
  printf '%s' "$value"
}

# True for the paths the 8.26.6-era Spaced GRUB theme used.
spaced_era_grub_path() {
  case $1 in
    /boot/grub/themes/spaced/*|/usr/share/backgrounds/spaced/*|/usr/share/spaced-themes/*)
      return 0 ;;
    *) return 1 ;;
  esac
}

repair_grub_theme() {
  local prefix= config tmp line value broken=0 changed=0 any_changed=0
  if [[ ${SPACED_UPDATE_TEST:-} == 1 ]]; then
    # Test hook only: repair a temporary root. pkexec strips test variables,
    # so this cannot redirect the production path. Without the hook a test
    # run leaves the host's GRUB configuration alone.
    [[ -n ${SPACED_UPDATE_TEST_GRUB_ROOT:-} ]] || return 0
    prefix=$SPACED_UPDATE_TEST_GRUB_ROOT
  elif [[ $EUID != 0 ]]; then
    return 0
  fi
  local configs=("$prefix/etc/default/grub") snippet
  for snippet in "$prefix"/etc/default/grub.d/*.cfg; do
    [[ -f $snippet ]] && configs+=("$snippet")
  done
  for config in "${configs[@]}"; do
    [[ -f $config ]] || continue
    while IFS= read -r line || [[ -n $line ]]; do
      if value=$(grub_assignment_value "$line") && spaced_era_grub_path "$value" &&
         [[ ! -r $prefix$value ]]; then
        broken=1
      fi
    done < "$config"
  done
  if (( ! broken )); then
    return 0
  fi
  if [[ ! -r $prefix$GRUB_THEME_PATH ]]; then
    log 'The packaged Spaced GRUB theme is not installed yet; the GRUB configuration was left unchanged.'
    return 0
  fi
  for config in "${configs[@]}"; do
    [[ -f $config ]] || continue
    tmp=$(mktemp "${config}.XXXXXX") || return 1
    local file_broken=0 theme_seen=0
    local replacement="GRUB_THEME=\"$GRUB_THEME_PATH\""
    while IFS= read -r line || [[ -n $line ]]; do
      if value=$(grub_assignment_value "$line") && spaced_era_grub_path "$value"; then
        if [[ -r $prefix$value ]]; then
          [[ ${value} == "$GRUB_THEME_PATH" ]] && theme_seen=1
          printf '%s\n' "$line"
        elif [[ ${line%%=*} == GRUB_THEME ]]; then
          file_broken=1; theme_seen=1; changed=1
          printf '%s\n' "$replacement"
        else
          # A 8.26.6-era background line keeps the menu broken; the theme
          # carries its own background, so drop it.
          file_broken=1; changed=1
        fi
      else
        printf '%s\n' "$line"
      fi
    done < "$config" > "$tmp"
    if (( file_broken )) && (( ! theme_seen )); then
      printf '%s\n' "$replacement" >> "$tmp"
      changed=1
    fi
    if (( changed )); then
      chmod --reference="$config" "$tmp" || return 1
      mv "$tmp" "$config" || return 1
      any_changed=1
    else
      rm -f "$tmp"
    fi
    changed=0
  done
  if (( any_changed )); then
    log 'Repaired the GRUB theme of an old Spaced install (crhy/spacedupdate#17); the boot refresh below applies it.'
  fi
  return 0
}

# Optional cleanup safety list (issue #217). The privileged helper never
# cleans up during updates; cleanup only runs through the explicit
# cleanup-plan/cleanup-apply modes below. Any candidate matching one of
# these prefixes blocks autoremove entirely.
CLEANUP_PROTECTED_PATTERNS=(
  spaced-meta spaced-mate-default-settings spaced-themes spaced-wallpapers spaced-welcome
  mate- caja compiz libcompiz marco libmarco lightdm
  network-manager sysvinit elogind libpam-elogind xserver-xorg-core flatpak apt dpkg
)

# Prints why a package must not be autoremoved; succeeds only when blocked.
cleanup_protected_reason() {
  local package=$1 pattern running
  for pattern in "${CLEANUP_PROTECTED_PATTERNS[@]}"; do
    if [[ $package == "$pattern"* ]]; then
      printf 'matches protected pattern %s' "$pattern"
      return 0
    fi
  done
  running=$(uname -r)
  if [[ $package == "linux-image-$running" || $package == "linux-headers-$running" ]]; then
    printf 'running kernel %s; refusing' "$running"
    return 0
  fi
  return 1
}

cleanup_candidate_version() {
  local package=$1 version
  version=$(dpkg-query -W -f='${Version}' "$package" 2>/dev/null || true)
  if [[ -z $version ]]; then
    version=unknown
  fi
  printf '%s' "$version"
}

# Reads apt-get autoremove simulation output on stdin; prints one package
# name per line in first-seen order.
cleanup_parse_simulation() {
  local line word in_removed=0
  declare -A seen=()
  while IFS= read -r line; do
    if [[ $line =~ ^Remv[[:space:]]+([^[:space:]]+) ]]; then
      word=${BASH_REMATCH[1]%%:*}
      if [[ -n $word && -z ${seen[$word]:-} ]]; then
        seen[$word]=1
        printf '%s\n' "$word"
      fi
    elif (( in_removed == 0 )) && [[ $line == *'will be REMOVED:'* ]]; then
      in_removed=1
    elif (( in_removed == 1 )); then
      if [[ $line =~ ^[[:space:]]+[^[:space:]] ]]; then
        for word in $line; do
          word=${word%%:*}
          word=${word%,}
          if [[ -n $word && -z ${seen[$word]:-} ]]; then
            seen[$word]=1
            printf '%s\n' "$word"
          fi
        done
      elif [[ -z ${line//[[:space:]]/} ]]; then
        continue
      else
        in_removed=0
      fi
    fi
  done
  return 0
}

# Shared planning used by both cleanup modes; never trusts caller input.
# Sets CLEANUP_PKGS, CLEANUP_SAFE, CLEANUP_BLOCKED ("name|reason") and
# CLEANUP_CACHE_BYTES.
cleanup_compute_plan() {
  local simulation cache_dir package reason
  simulation=$(apt_run -s autoremove)
  mapfile -t CLEANUP_PKGS < <(cleanup_parse_simulation <<< "$simulation")
  CLEANUP_SAFE=()
  CLEANUP_BLOCKED=()
  if (( ${#CLEANUP_PKGS[@]} > 50 )); then
    reason="unusually large removal set; refusing (${#CLEANUP_PKGS[@]} packages)"
    for package in "${CLEANUP_PKGS[@]}"; do
      CLEANUP_BLOCKED+=("$package|$reason")
    done
  else
    for package in "${CLEANUP_PKGS[@]}"; do
      if reason=$(cleanup_protected_reason "$package"); then
        CLEANUP_BLOCKED+=("$package|$reason")
      else
        CLEANUP_SAFE+=("$package")
      fi
    done
  fi
  cache_dir=/var/cache/apt/archives
  if [[ ${SPACED_UPDATE_TEST:-} == 1 && -n ${SPACED_UPDATE_TEST_CACHE_DIR:-} ]]; then
    cache_dir=$SPACED_UPDATE_TEST_CACHE_DIR
  fi
  # apt clean removes downloaded files, not the lock or directory metadata.
  # Include partial downloads, which apt also removes.
  CLEANUP_CACHE_BYTES=$(find "$cache_dir" -type f ! -name lock -printf '%s\n' \
    2>/dev/null | awk '{total += $1} END {printf "%.0f\n", total}' || true)
  if [[ ! $CLEANUP_CACHE_BYTES =~ ^[0-9]+$ ]]; then
    CLEANUP_CACHE_BYTES=0
  fi
}

# Exit code meaning "package cache cleaned; autoremove refused for safety".
# Distinct from real failures, which keep the existing codes below (1 for
# errors and safety refusals during updates, 2 for usage errors, 75 for a
# contended transaction lock, plus the ERR trap status). 126 is pkexec's own
# authentication-cancelled code and never comes from this script.
CLEANUP_CACHE_ONLY_STATUS=3

MODE=${1:-all}
if [ "$#" -gt 0 ]; then shift; fi
case "$MODE" in
  apt-refresh|all) [ "$#" -eq 0 ] || { log 'Unexpected update arguments.'; exit 2; } ;;
  cleanup-plan|cleanup-apply) [ "$#" -eq 0 ] || { log 'Unexpected update arguments.'; exit 2; } ;;
  apt-install)
    [ "$#" -gt 0 ] || { log 'No APT packages were selected.'; exit 2; }
    for PACKAGE in "$@"; do
      # A trailing +/- is an APT install/remove instruction, not a selection.
      if [[ ! $PACKAGE =~ ^[a-z0-9][a-z0-9.+-]*[a-z0-9](:[a-z0-9][a-z0-9-]*)?$ ]] ||
         [[ $(dpkg-query -W -f='${db:Status-Status}' "$PACKAGE") != installed ]]; then
        log "Invalid or uninstalled APT package: $PACKAGE"; exit 2
      fi
    done ;;
  flatpak-update)
    SCOPE=${1:-}
    if [[ $SCOPE != --system && ! $SCOPE =~ ^--installation=[a-zA-Z0-9._-]+$ ]]; then
      log 'The privileged helper only updates system Flatpak installations.'; exit 2
    fi
    shift
    [ "$#" -gt 0 ] || { log 'No Flatpak refs were selected.'; exit 2; }
    for REF in "$@"; do
      if [[ ! $REF =~ ^(app/|runtime/)?[a-zA-Z0-9._-]+/[a-zA-Z0-9_-]+/[a-zA-Z0-9._-]+$ ]]; then
        log "Invalid Flatpak ref: $REF"; exit 2
      fi
    done ;;
  *) log "Unknown update mode: $MODE"; exit 2 ;;
esac

# The patched elogind runtime is published as one coordinated set. In
# particular, libpam-elogind depends on the exact elogind version and elogind
# depends on the exact libelogind0 version. A selected-update click can name
# just one row, so include every installed member or APT can reject the partial
# plan while the complete update would be valid (issue #419).
if [[ $MODE == apt-install ]]; then
  SELECTED_PACKAGES=("$@")
  ELOGIND_SET_SELECTED=0
  for PACKAGE in "${SELECTED_PACKAGES[@]}"; do
    case "${PACKAGE%%:*}" in
      elogind|libelogind0|libelogind-compat|libpam-elogind)
        ELOGIND_SET_SELECTED=1 ;;
    esac
  done
  if (( ELOGIND_SET_SELECTED )); then
    for PACKAGE in elogind libelogind0 libelogind-compat libpam-elogind; do
      [[ $(dpkg-query -W -f='${db:Status-Status}' "$PACKAGE" 2>/dev/null || true) == installed ]] || continue
      ALREADY_SELECTED=0
      for SELECTED in "${SELECTED_PACKAGES[@]}"; do
        [[ ${SELECTED%%:*} == "$PACKAGE" ]] && ALREADY_SELECTED=1
      done
      (( ALREADY_SELECTED )) || SELECTED_PACKAGES+=("$PACKAGE")
    done
    set -- "${SELECTED_PACKAGES[@]}"
  fi
fi

# Serialize privileged operations across windows and the native/Flatpak app.
# APT also takes its own locks, including against unrelated package managers.
# The read-only cleanup plan takes no lock; cleanup-apply serializes like updates.
if [[ $MODE != cleanup-plan ]]; then
  if [[ ${SPACED_UPDATE_TEST:-} == 1 ]]; then
    : # Tests run the helper directly without the system transaction lock.
  else
    exec 9>/run/lock/spaced-update.lock
    if ! flock -n 9; then
      log 'Another Spaced Update transaction is running. Wait for it to finish and retry.'
      exit 75
    fi
  fi
fi

APT_OPTIONS=(-o DPkg::Lock::Timeout=120 -o Acquire::Retries=3
             -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30
             -o APT::Update::Error-Mode=any -o Dpkg::Use-Pty=0
             -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
apt_run() { apt-get "${APT_OPTIONS[@]}" "$@"; }

verify_package_health() {
  local context=$1 audit
  apt_run check
  if ! audit=$(dpkg --audit 2>&1); then
    log "$audit"
    log "dpkg could not audit package health $context. No further update steps will run."
    return 1
  fi
  if [[ -n ${audit//[[:space:]]/} ]]; then
    log "$audit"
    log "The package database is not healthy $context. No further update steps will run."
    return 1
  fi
}

# APT's machine-readable progress shares the log pipe through a dedicated
# descriptor.  Do not use descriptor 1 as APT::Status-Fd: APT closes the
# status descriptor before running dpkg, and that would also close stdout in
# maintainer scripts (issue #373).
apt_run_status() {
  apt-get "${APT_OPTIONS[@]}" -o APT::Status-Fd=3 "$@" 3>&1 |
    sed -u -e 's/^\(dlstatus\|pmstatus\):/STATUS &/'
}

if [[ $MODE == all || $MODE == apt-install || $MODE == cleanup-apply ]]; then
  GUARD=/usr/lib/spaced-linux/spaced-update-apt-guard
  GLOBAL_GUARD_CONFIG=/etc/apt/apt.conf.d/60spaced-transaction-guard
  if [[ ${SPACED_UPDATE_TEST:-} == 1 && -n ${SPACED_UPDATE_TEST_GUARD:-} ]]; then
    # Test hook only: validate a stub guard instead of the installed one.
    # pkexec strips test variables in production, so this cannot redirect
    # the real privileged path.
    GUARD=$SPACED_UPDATE_TEST_GUARD
  fi
  if [[ ! -f $GUARD || ! -x $GUARD || -L $GUARD ]]; then
    log 'The installed Spaced Update APT transaction guard is missing. Reinstall spaced-mate-default-settings or run the complete Spaced Update install.sh before retrying. No package changes were started.'
    exit 1
  fi
  read -r GUARD_OWNER GUARD_MODE <<< "$(stat -c '%u %a' "$GUARD")"
  # In test mode the stub guard is owned by the invoking test user, so the
  # root-ownership requirement is relaxed there only. The production path
  # still demands root ownership, and the no-group/other-write check applies
  # in both modes.
  if [[ ${SPACED_UPDATE_TEST:-} != 1 && $GUARD_OWNER != 0 ]] || (( (8#$GUARD_MODE & 8#022) != 0 )); then
    log 'The Spaced Update APT guard must be owned by root and not writable by other accounts. Reinstall the native package before retrying.'
    exit 1
  fi
  # New installations load the guard globally so root-terminal APT commands
  # receive the same protection. Keep passing it explicitly on old systems
  # and in tests until the package containing that configuration is installed.
  if [[ ${SPACED_UPDATE_TEST:-} == 1 ]] ||
     [[ ! -f $GLOBAL_GUARD_CONFIG || -L $GLOBAL_GUARD_CONFIG ]] ||
     ! grep -Fq '"/usr/lib/spaced-linux/spaced-update-apt-guard";' "$GLOBAL_GUARD_CONFIG" ||
     ! grep -Fq 'spaced-update-apt-guard::Version "2";' "$GLOBAL_GUARD_CONFIG"; then
    APT_OPTIONS+=(-o "DPkg::Pre-Install-Pkgs::=$GUARD"
                 -o "DPkg::Tools::Options::$GUARD::Version=2")
  fi
fi

if [[ $MODE == flatpak-update ]]; then
  step 30 "Updating selected Flatpak apps and runtimes ($SCOPE)"
  flatpak update --noninteractive -y "$SCOPE" "$@"
  step 100 'Selected Flatpak updates complete'
  exit 0
fi

# Optional cleanup (issue #217). This is the only path that removes
# packages or cleans the cache; the update modes never clean up automatically.
if [[ $MODE == cleanup-plan ]]; then
  cleanup_compute_plan
  if (( ${#CLEANUP_SAFE[@]} > 0 )); then
    for PACKAGE in "${CLEANUP_SAFE[@]}"; do
      log "REMOVE $PACKAGE $(cleanup_candidate_version "$PACKAGE")"
    done
  fi
  if (( ${#CLEANUP_BLOCKED[@]} > 0 )); then
    for ENTRY in "${CLEANUP_BLOCKED[@]}"; do
      log "BLOCKED ${ENTRY%%|*} ${ENTRY#*|}"
    done
  fi
  log "AUTOCLEAN_BYTES $CLEANUP_CACHE_BYTES"
  exit 0
fi

if [[ $MODE == cleanup-apply ]]; then
  step 5 'Checking the cleanup plan'
  cleanup_compute_plan
  if (( ${#CLEANUP_BLOCKED[@]} > 0 )); then
    log 'Cleanup refused automatic removal for safety; cleaning the package cache only.'
    for ENTRY in "${CLEANUP_BLOCKED[@]}"; do
      log "Blocked package: ${ENTRY%%|*} (${ENTRY#*|})"
    done
    step 40 'Cleaning the package cache'
    apt_run -y clean
    log 'Package cache cleaned. The blocked packages were left installed.'
    exit "$CLEANUP_CACHE_ONLY_STATUS"
  fi
  step 40 'Cleaning the package cache'
  apt_run -y clean
  if (( ${#CLEANUP_SAFE[@]} == 0 )); then
    step 100 'Package cache cleaned'
    exit 0
  fi
  step 70 'Removing unused packages'
  ensure_session_guard
  apt_run -y autoremove
  step 100 'Cleanup complete'
  exit 0
fi

step 5 'Refreshing APT package lists'
apt_run update
if [[ $MODE == apt-refresh ]]; then
  step 100 'Package lists refreshed'
  exit 0
fi

# A retry can finish packages left unpacked by an interrupted transaction.
# Do not guess at dependency repairs or force-remove packages on failure.
step 10 'Completing pending package configuration'
ensure_session_guard
dpkg --force-confdef --force-confold --configure --pending
step 12 'Verifying package database health'
verify_package_health 'before the update'
if [[ $MODE == apt-install ]]; then
  TRANSACTION=(--only-upgrade --no-remove install "$@")
else
  # Earliest Spaced installations did not carry the release metapackage.
  # Include it explicitly so every current runtime dependency is delivered.
  TRANSACTION=(dist-upgrade spaced-meta)
fi

step 15 'Checking the upgrade plan'
if PLAN=$(apt_run --simulate "${TRANSACTION[@]}" 2>&1); then
  :
else
  PLAN_STATUS=$?
  log "$PLAN"
  log 'APT could not produce a safe upgrade plan. No upgrade packages were installed by this attempt.'
  log 'The repositories may be between coordinated uploads. Do not force the upgrade from a terminal; wait for the mirrors to settle, refresh, and retry Spaced Update.'
  exit "$PLAN_STATUS"
fi
log "$PLAN"
while read -r ACTION PACKAGE _; do
  PACKAGE=${PACKAGE%%:*}
  case "$ACTION:$PACKAGE" in
    Inst:systemd-sysv|Inst:systemd|Inst:runit-init|Inst:openrc)
      log "Refusing an upgrade that changes the sysvinit system: $PACKAGE"; exit 1 ;;
    Remv:sysvinit-core|Remv:sysvinit-utils|Remv:initscripts|Remv:spaced-meta|Remv:spaced-mate-default-settings|Remv:mate-session-manager|Remv:mate-panel|Remv:caja|Remv:compiz|Remv:lightdm|Remv:network-manager|Remv:apt|Remv:dpkg|Remv:flatpak)
      log "Refusing removal of a core Spaced Linux package: $PACKAGE"; exit 1 ;;
  esac
done <<< "$PLAN"

step 20 'Downloading package upgrades'
apt_run_status -y --download-only "${TRANSACTION[@]}"
step 35 'Installing APT upgrades'
if ! apt_run_status -y "${TRANSACTION[@]}"; then
  # Issue #337: a transient maintainer-script/configuration failure left a
  # dependency chain unpacked, and pressing Update a second time completed it.
  # Perform that same bounded recovery automatically. Do not remove packages,
  # run apt -f, or hide a second failure from the user.
  log 'The first installation pass did not finish; retrying pending package configuration once.'
  step 40 'Recovering interrupted package configuration'
  dpkg --force-confdef --force-confold --configure --pending
  apt_run check
  step 45 'Retrying APT upgrades'
  apt_run_status -y "${TRANSACTION[@]}"
fi

step 50 'Finalizing package configuration'
dpkg --force-confdef --force-confold --configure --pending
dpkg --triggers-only --pending

step 55 'Verifying completed package transactions'
verify_package_health 'after the update'

# Maintainer scripts normally handle these, but report a failed final refresh.
# Keep cached downloads and old kernels for recovery; cleanup is not an update.
step 65 'Refreshing boot files'
if command -v update-initramfs >/dev/null 2>&1; then update-initramfs -u -k all; fi
ROOT_FSTYPE=$(findmnt -n -o FSTYPE / 2>/dev/null || true)
if [[ $ROOT_FSTYPE == overlay ]]; then
  # A live session has no installed boot filesystem for grub-probe to resolve;
  # its root is the live-boot .overlay mount. Package maintainer scripts have
  # already refreshed anything they own, and update-initramfs above is still
  # useful for validating the installed kernels. Do not turn a completed live
  # package transaction into a false update failure (issue #419).
  log 'Skipping GRUB refresh for the live overlay root.'
else
  # crhy/spacedupdate#17: repoint an old broken GRUB theme setting before
  # refreshing the boot files, so update-grub below applies it exactly once.
  repair_grub_theme || log 'The GRUB theme repair did not complete; the GRUB configuration was left unchanged.'
  if command -v update-grub >/dev/null 2>&1; then
    update-grub
  fi
fi

if [[ $MODE == all ]] && command -v flatpak >/dev/null 2>&1; then
  step 80 'Updating system Flatpak apps and runtimes'
  flatpak update --noninteractive -y --system
  INSTALLATIONS=$(flatpak list --all --columns=installation)
  while read -r INSTALLATION; do
    case "$INSTALLATION" in ''|user|system|default) continue ;; esac
    flatpak update --noninteractive -y "--installation=$INSTALLATION"
  done < <(printf '%s\n' "$INSTALLATIONS" | sort -u)
fi

HELD=$(apt-mark showhold)
if [[ -n $HELD ]]; then
  log 'SPACED_WARNING:Some packages are held by the administrator and were not forced to upgrade:'
  log "$HELD"
fi
step 100 'Requested system updates complete'
log 'APT updates completed. Per-user Flatpaks are updated by the desktop application.'

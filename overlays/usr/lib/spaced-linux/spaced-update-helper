#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
step() { printf 'SPACED_STEP:%s:%s\n' "$1" "$2"; }
log() { printf '%s\n' "$*"; }

MODE="${1:-all}"

if [ "$MODE" = "apt-install" ]; then
  shift
  if [ "$#" -eq 0 ]; then
    log 'No APT packages were selected.'
    exit 2
  fi
  for PACKAGE in "$@"; do
    if [[ ! "$PACKAGE" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+-]*(:[a-zA-Z0-9][a-zA-Z0-9_-]*)?$ ]]; then
      log "Invalid APT package name: $PACKAGE"
      exit 2
    fi
  done
  step 10 'Refreshing APT package lists'
  apt-get update
  step 40 'Installing selected packages'
  apt-get -y install "$@"
  step 70 'Removing obsolete packages'
  apt-get -y autoremove --purge || true
  step 90 'Repairing boot menu entries'
  if command -v update-grub >/dev/null 2>&1; then update-grub; fi
  step 100 'Selected updates complete'
  exit 0
fi

if [ "$MODE" = "flatpak-update" ]; then
  shift
  SCOPE="${1:---user}"
  shift || true
  if [ "$SCOPE" != "--user" ] && [ "$SCOPE" != "--system" ]; then
    log "Invalid Flatpak installation scope: $SCOPE"
    exit 2
  fi
  if [ "$#" -eq 0 ]; then
    log 'No Flatpak applications were selected.'
    exit 2
  fi
  step 30 "Updating selected Flatpak applications ($SCOPE)"
  flatpak update -y "$SCOPE" "$@"
  step 100 'Flatpak updates complete'
  exit 0
fi

if [ "$MODE" != "all" ]; then
  log "Unknown update mode: $MODE"
  exit 2
fi

step 5 'Refreshing APT package lists'
apt-get update
step 25 'Installing APT upgrades'
apt-get -y dist-upgrade
step 60 'Removing obsolete APT packages'
apt-get -y autoremove --purge
apt-get clean
step 70 'Updating system Flatpaks'
if command -v flatpak >/dev/null 2>&1; then
  flatpak update -y --system || true
fi
step 82 'Repairing boot menu entries'
if command -v update-grub >/dev/null 2>&1; then
  update-grub
fi
step 90 'Refreshing initramfs'
if command -v update-initramfs >/dev/null 2>&1; then
  update-initramfs -u -k all
fi
step 100 'System updates complete'
log 'APT and system Flatpak updates completed.'

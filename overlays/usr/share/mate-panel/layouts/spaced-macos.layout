[Toplevel bottom]
expand=true
orientation=top
size=30
auto-hide=false

[Object brisk-menu]
object-type=applet
applet-iid=BriskMenuFactory::BriskMenu
toplevel-id=bottom
position=0

[Object window-list]
object-type=applet
applet-iid=WnckletFactory::WindowListApplet
toplevel-id=bottom
position=20

[Object notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=bottom
position=60
relative-to-edge=end

[Object volume-control-applet]
object-type=applet
applet-iid=VolAppletFactory::VolumePagerApplet
toplevel-id=bottom
position=63
relative-to-edge=end

[Object clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=bottom
position=66
relative-to-edge=end

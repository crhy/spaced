<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal org.gnome.metacity schema.

  Devuan Ceres does not ship the upstream org.gnome.metacity GSettings
  schema. MATE 1.26's
  mate-appearance-properties reads this schema to render the Metacity
  window preview inside each theme thumbnail; without it the capplet
  logs "No such schema org.gnome.metacity" and produces NO theme
  previews. We ship a minimal compatible schema so previews work.
-->
<schemalist>
  <schema id="org.gnome.metacity" path="/org/gnome/metacity/">
    <key name="theme" type="s">
      <default>'Adwaita'</default>
      <summary>Metacity theme</summary>
    </key>
    <key name="titlebar-font" type="s">
      <default>'Sans 10'</default>
      <summary>Titlebar font</summary>
    </key>
    <key name="button-layout" type="s">
      <default>'appmenu:minimize,maximize,close'</default>
      <summary>Button layout</summary>
    </key>
    <key name="alt-button-order" type="as">
      <default>[]</default>
      <summary>Alt button order</summary>
    </key>
    <key name="compositing-manager" type="b">
      <default>false</default>
      <summary>Compositing manager</summary>
    </key>
  </schema>
  <schema id="org.gnome.metacity.theme" path="/org/gnome/metacity/theme/">
    <key name="name" type="s">
      <default>'Adwaita'</default>
      <summary>Theme name</summary>
    </key>
    <key name="titlebar-font" type="s">
      <default>'Sans 10'</default>
      <summary>Titlebar font</summary>
    </key>
  </schema>
</schemalist>

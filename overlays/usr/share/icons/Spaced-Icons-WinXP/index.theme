[Icon Theme]
Name=Spaced Windows XP folder icons
Comment=Spaced Windows XP folder color over Papirus Dark
Inherits=Spaced-Menu-On-Dark,Papirus,hicolor
Directories=48x48/places,scalable/places,scalable/devices

[48x48/places]
Size=48
Context=Places
Type=Fixed

[scalable/places]
Size=64
Context=Places
Type=Scalable
MinSize=16
MaxSize=256

[scalable/devices]
Size=16
Context=Devices
Type=Scalable
MinSize=16
MaxSize=24
